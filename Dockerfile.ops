# Dockerfile.ops — רזה ומהיר
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Jerusalem \
    PORT=8000

# בסיס מערכת בלבד
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends tini ca-certificates tzdata curl \
 && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
 && dpkg-reconfigure -f noninteractive tzdata \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# דרישות מינימליות
COPY requirements.ops.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
 && pip install --only-binary=:all: -r requirements.txt

# קוד
COPY . .

# בריאות
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=8s --retries=5 \
  CMD curl -fsS http://127.0.0.1:${PORT}/readyz || exit 1

ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["gunicorn","-k","uvicorn.workers.UvicornWorker","-w","2","-b","0.0.0.0:8000","main:app","--timeout","120"]
