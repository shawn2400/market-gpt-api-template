import matplotlib.pyplot as plt
import os

# יצירת תיקייה סטטית אם אינה קיימת
os.makedirs("static", exist_ok=True)

# נתוני דוגמה – ניתן להחליף לנתונים אמיתיים מ־Binance או backtest
x = [1, 2, 3]
y = [4, 5, 6]

# יצירת הגרף
plt.figure(figsize=(6, 4))
plt.plot(x, y, marker='o', linestyle='-', color='blue', label="קו מגמה")
plt.title("📈 גרף דוגמה פשוט", fontsize=14)
plt.xlabel("ציר X", fontsize=12)
plt.ylabel("ציר Y", fontsize=12)
plt.grid(True)
plt.legend()
plt.tight_layout()

# שמירת הגרף לקובץ
output_path = "static/chart.png"
plt.savefig(output_path)
plt.close()

print(f"✅ גרף נשמר בהצלחה: {output_path}")




