# 🔐 AlgoGPT v10.0 — Official 6 Integrations Configuration
# Only enable integrations you have API keys for

# ============================================
# 1️⃣ CRYPTOHOPPER API (Scans + Signals)
# ============================================
ENABLE_CRYPT=true
CRYPTOHOPPER_API_KEY=your_api_key_here

# ============================================
# 2️⃣ 3COMMAS API (SmartTrade Position Management)
# ============================================
ENABLE_3COMM=true
THREECOMMAS_API_KEY=your_api_key_here
THREECOMMAS_API_SECRET=your_api_secret_here

# ============================================
# 3️⃣ WUNDERTRADING API (Signals)
# ============================================
ENABLE_WUNDER=true
WUNDER_API_KEY=your_api_key_here

# ============================================
# 4️⃣ BYBIT API (Secondary Execution + Signals)
# ============================================
ENABLE_BYBIT=true
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# ============================================
# 5️⃣ TRADINGVIEW WEBHOOKS (Indicators + Alerts)
# ============================================
ENABLE_TV_WEBHOOK=true
TV_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# BINANCE API (Primary Execution)
# This is ALWAYS enabled - no toggle
# ============================================
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ============================================
# ❌ REMOVED/UNSUPPORTED (DO NOT USE)
# ============================================
# HyperTrader - NOT SUPPORTED
# Pionex - NOT SUPPORTED
# Bitsgap - NOT SUPPORTED
# Coinrule - NOT SUPPORTED
# Kryll - NOT SUPPORTED
# Stoic.ai - NOT SUPPORTED
# ProfitTrailer - NOT SUPPORTED
