# .gitignore

# === Environment files ===
.env
*.env

# === Sensitive / Security ===
*.key
*.pem
saved_trades.json
pnl_tracker.json

# === Logs ===
*.log

# === Python build / temp ===
__pycache__/
*.pyc
*.pyo
*.pyd
.cache/
.pytest_cache/
*.sqlite3

# === Virtual environments ===
venv/
.venv/

# === IDE / Editor ===
.vscode/
.idea/
*.iml

# === OS / Misc ===
.DS_Store
Thumbs.db

# === Static outputs ===
*.pdf
static/reports/
static/snapshots/

# === Docker build artifacts ===
*.pid
*.tar
*.lock
*.bak

# === Tests artifacts ===
tests/


