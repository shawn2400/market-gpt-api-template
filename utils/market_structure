# utils/market_structure/__init__.py
from __future__ import annotations
from typing import Tuple
import numpy as np
import pandas as pd

def _pivot_high_idx(high: pd.Series, span: int) -> pd.Series:
    # פיבוט שיא: גבוה מהשכנים בטווח span
    return (high == high.rolling(span, center=True, min_periods=1).max())

def _pivot_low_idx(low: pd.Series, span: int) -> pd.Series:
    # פיבוט שפל: נמוך מהשכנים בטווח span
    return (low == low.rolling(span, center=True, min_periods=1).min())

def _last_two(values: list[Tuple[int, float]]) -> list[Tuple[int, float]]:
    return values[-2:] if len(values) >= 2 else values

def add_market_structure_columns(
    df: pd.DataFrame,
    *,
    ms_lookback: int = 5,
    ms_pivot_span: int = 3,
    high_col: str = "high",
    low_col: str = "low",
) -> pd.DataFrame:
    """
    מוסיף עמודות:
      - ms_label: HH/HL/LH/LL על בסיס שני השיאים/שפלים האחרונים
      - ms_trend: UP/DOWN/RANGE לפי שילוב HH/HL מול LH/LL
    """
    if df is None or df.empty:
        d = pd.DataFrame(columns=list(df.columns) + ["ms_label", "ms_trend"]) if df is not None else pd.DataFrame(columns=["ms_label","ms_trend"])
        d["ms_label"] = ""
        d["ms_trend"] = "RANGE"
        return d

    d = df.copy()
    if high_col not in d.columns or low_col not in d.columns:
        d["ms_label"] = ""
        d["ms_trend"] = "RANGE"
        return d

    high = pd.to_numeric(d[high_col], errors="coerce")
    low  = pd.to_numeric(d[low_col], errors="coerce")

    ph_mask = _pivot_high_idx(high, ms_pivot_span).fillna(False)
    pl_mask = _pivot_low_idx(low,  ms_pivot_span).fillna(False)

    # אסוף אינדקסים/ערכים של פיבוטים
    piv_high = [(i, float(high.iat[i])) for i in range(len(d)) if bool(ph_mask.iat[i])]
    piv_low  = [(i, float(low.iat[i]))  for i in range(len(d)) if bool(pl_mask.iat[i])]

    # נקח אחרונים לטובת קביעה
    highs2 = _last_two(piv_high)
    lows2  = _last_two(piv_low)

    ms_label_series = []
    ms_trend_series = []

    # נעבור ברשומה-רשומה אך החישוב נשען על הזיהוי הכולל
    # (פשטות: משתמשים בתוצאה האחרונה עבור כל השורה)
    label = ""
    trend = "RANGE"

    if len(highs2) == 2 and len(lows2) == 2:
        h_prev, h_last = highs2[-2], highs2[-1]
        l_prev, l_last = lows2[-2],  lows2[-1]

        hh_lh = "HH" if h_last[1] > h_prev[1] else "LH"
        hl_ll = "HL" if l_last[1] > l_prev[1] else "LL"

        label = f"{hh_lh}/{hl_ll}"
        if hh_lh == "HH" and hl_ll == "HL":
            trend = "UP"
        elif hh_lh == "LH" and hl_ll == "LL":
            trend = "DOWN"
        else:
            trend = "RANGE"

    # מלא אחיד על כל הרשומות (גזרה "כאן ועכשיו")
    ms_label_series = pd.Series([label] * len(d), index=d.index, dtype="object")
    ms_trend_series = pd.Series([trend] * len(d), index=d.index, dtype="object")

    d["ms_label"] = ms_label_series
    d["ms_trend"] = ms_trend_series
    return d


