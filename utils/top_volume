# utils/top_volume/__init__.py
from __future__ import annotations
import os, time
from typing import List, Tuple
import requests

FUTURES_BASE = os.getenv("BINANCE_FUTURES_HTTP_BASE", "https://fapi.binance.com")
SPOT_BASE    = os.getenv("BINANCE_SPOT_HTTP_BASE",    "https://api.binance.com")

_S = requests.Session()
_S.trust_env = False
_S.headers.update({"User-Agent": "AlgoGPT/2 top-volume"})

def _get_json(url: str, *, timeout: float = 7.0):
    for i in range(2):
        try:
            r = _S.get(url, timeout=timeout)
            if r.status_code == 200:
                return r.json()
        except Exception:
            pass
        time.sleep(0.5)
    return None

def _pick_symbols_24h(stats, *, quote: str, limit: int, prefer_quote_volume: bool = True) -> List[str]:
    rows = []
    for it in (stats or []):
        sym = it.get("symbol") or ""
        if not sym.endswith(quote):
            continue
        qv = float(it.get("quoteVolume") or 0.0)
        bv = float(it.get("volume") or 0.0)
        score = qv if prefer_quote_volume else bv
        rows.append((sym, score))
    rows.sort(key=lambda x: x[1], reverse=True)
    return [s for s, _ in rows[: max(1, int(limit))]]

def futures_top_symbols(quote: str = "USDT", limit: int = 50) -> List[str]:
    """Top by 24h quoteVolume on Binance Futures."""
    url = f"{FUTURES_BASE}/fapi/v1/ticker/24hr"
    data = _get_json(url) or []
    return _pick_symbols_24h(data, quote=quote.upper(), limit=limit, prefer_quote_volume=True)

def spot_top_symbols(quote: str = "USDT", limit: int = 50) -> List[str]:
    """Top by 24h quoteVolume on Binance Spot."""
    url = f"{SPOT_BASE}/api/v3/ticker/24hr"
    data = _get_json(url) or []
    return _pick_symbols_24h(data, quote=quote.upper(), limit=limit, prefer_quote_volume=True)

def get_top_volume_symbols(market: str = "futures", quote: str = "USDT", limit: int = 50) -> Tuple[bool, List[str]]:
    market = (market or "futures").lower()
    try:
        if market == "spot":
            return True, spot_top_symbols(quote=quote, limit=limit)
        return True, futures_top_symbols(quote=quote, limit=limit)
    except Exception:
        return False, []
