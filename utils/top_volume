# utils/top_volume.py
from __future__ import annotations

import os
import time
from typing import List, Tuple, Dict, Any, Optional
import requests

FUTURES_BASE = os.getenv("BINANCE_FUTURES_HTTP_BASE", "https://fapi.binance.com")
SPOT_BASE    = os.getenv("BINANCE_SPOT_HTTP_BASE",    "https://api.binance.com")

# קאשינג עדין כדי לא להציף את Binance אם נקרא בתדירות גבוהה
_CACHE: Dict[str, Dict[str, Any]] = {}  # key -> {ts, data}
_CACHE_TTL = float(os.getenv("TOP_VOLUME_CACHE_TTL_SEC", "45"))  # שניות

_S = requests.Session()
_S.trust_env = False
_S.headers.update({
    "User-Agent": "AlgoGPT/2 top-volume",
    "Accept": "application/json",
    "Accept-Encoding": "gzip",
})

def _cache_get(key: str) -> Optional[Any]:
    item = _CACHE.get(key)
    if not item:
        return None
    if time.time() - item["ts"] > _CACHE_TTL:
        return None
    return item["data"]

def _cache_put(key: str, data: Any) -> None:
    _CACHE[key] = {"ts": time.time(), "data": data}

def _get_json(url: str, *, timeout: float = 8.0) -> Optional[Any]:
    key = f"GET:{url}"
    hit = _cache_get(key)
    if hit is not None:
        return hit
    for _ in range(2):  # רה-טריי עדין
        try:
            r = _S.get(url, timeout=timeout)
            if r.status_code == 200:
                data = r.json()
                _cache_put(key, data)
                return data
        except Exception:
            time.sleep(0.35)
    return None

def _pick_symbols_24h(
    stats: Any, *,
    quote: str,
    limit: int,
    min_quote_volume: float = 0.0,
    prefer_quote_volume: bool = True
) -> List[str]:
    rows: List[Tuple[str, float]] = []
    q = (quote or "USDT").upper()
    for it in (stats or []):
        sym = (it.get("symbol") or "").upper()
        if not sym.endswith(q):
            continue
        try:
            qv = float(it.get("quoteVolume") or 0.0)   # נפח במונחי quote (USDT)
            bv = float(it.get("volume") or 0.0)        # נפח יחידות base
        except Exception:
            continue
        if qv < float(min_quote_volume or 0.0):
            continue
        score = qv if prefer_quote_volume else bv
        rows.append((sym, score))
    rows.sort(key=lambda x: x[1], reverse=True)
    return [s for s, _ in rows[: max(1, int(limit))]]

def futures_top_symbols(quote: str = "USDT", limit: int = 50,
                        min_quote_volume: float = 0.0) -> List[str]:
    """Top by 24h quoteVolume on Binance Futures."""
    url = f"{FUTURES_BASE}/fapi/v1/ticker/24hr"
    data = _get_json(url) or []
    return _pick_symbols_24h(
        data, quote=quote, limit=limit,
        min_quote_volume=min_quote_volume, prefer_quote_volume=True
    )

def spot_top_symbols(quote: str = "USDT", limit: int = 50,
                     min_quote_volume: float = 0.0) -> List[str]:
    """Top by 24h quoteVolume on Binance Spot."""
    url = f"{SPOT_BASE}/api/v3/ticker/24hr"
    data = _get_json(url) or []
    return _pick_symbols_24h(
        data, quote=quote, limit=limit,
        min_quote_volume=min_quote_volume, prefer_quote_volume=True
    )

def get_top_volume_symbols(
    market: str = "futures",
    quote: str = "USDT",
    limit: int = 50,
    min_quote_volume: float = 0.0
) -> Tuple[bool, List[str]]:
    """
    מחזיר (ok, symbols). TTL קאשינג מקטין latency ועומס.
    """
    market = (market or "futures").lower()
    try:
        if market == "spot":
            return True, spot_top_symbols(quote=quote, limit=limit, min_quote_volume=min_quote_volume)
        return True, futures_top_symbols(quote=quote, limit=limit, min_quote_volume=min_quote_volume)
    except Exception:
        return False, []

