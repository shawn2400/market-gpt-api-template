# utils/top_volume.py
from __future__ import annotations
import os
import requests
from typing import List, Tuple

FUTURES_BASE = os.getenv("BINANCE_FUTURES_HTTP_BASE", "https://fapi.binance.com")
SPOT_BASE    = os.getenv("BINANCE_SPOT_HTTP_BASE",    "https://api.binance.com")

_S = requests.Session()
_S.trust_env = False
_S.headers.update({"User-Agent": "AlgoGPT/2 top-volume", "Accept": "application/json"})

def _get_json(url: str, timeout: float = 8.0):
    r = _S.get(url, timeout=timeout)
    r.raise_for_status()
    return r.json()

def get_top_volume_symbols(
    market: str = "futures",
    quote: str = "USDT",
    limit: int = 50,
    min_quote_volume: float = 0.0,
) -> Tuple[bool, List[str]]:
    try:
        if market == "futures":
            arr = _get_json(f"{FUTURES_BASE}/fapi/v1/ticker/24hr")
            # סינון חוזים מתמשכים USDT בלבד
            rows = [x for x in arr if str(x.get("symbol","")).endswith(quote)]
            rows.sort(key=lambda x: float(x.get("quoteVolume", 0.0)), reverse=True)
            if min_quote_volume > 0:
                rows = [x for x in rows if float(x.get("quoteVolume", 0.0)) >= float(min_quote_volume)]
            syms = [x["symbol"] for x in rows[:limit]]
            return True, syms
        else:
            arr = _get_json(f"{SPOT_BASE}/api/v3/ticker/24hr")
            rows = [x for x in arr if str(x.get("symbol","")).endswith(quote)]
            rows.sort(key=lambda x: float(x.get("quoteVolume", 0.0)), reverse=True)
            if min_quote_volume > 0:
                rows = [x for x in rows if float(x.get("quoteVolume", 0.0)) >= float(min_quote_volume)]
            syms = [x["symbol"] for x in rows[:limit]]
            return True, syms
    except Exception:
        return False, []


