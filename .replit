modules = ["c-clang14", "cpp-clang14", "bash", "python-3.11"]

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = [
  "cairo", "cargo", "ffmpeg-full", "freetype", "ghostscript",
  "glibcLocales", "gobject-introspection", "gtk3", "lcms2",
  "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp",
  "libxcrypt", "libyaml", "openjpeg", "pkg-config", "qhull",
  "rustc", "tcl", "tk", "xsimd", "zlib"
]

[workflows]
runButton = "Project"

# === Workflow 1: AlgoGPT Server (FastAPI + Gunicorn) ===
[[workflows.workflow]]
name = "AlgoGPT Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = '''
AUTO_RUN=1 EXECUTE_TRADES=1 TRADE_AUTO_SUGGEST=1 SUGGEST_FUTURES=1 \
ALLOW_MANAGE_OPEN_TRADES=1 PAUSE_AUTO_RUN=0 MANAGER_ENABLE=1 \
TRADE_MANAGER_ENABLE=1 TELEGRAM_SEND_ENABLE=1 APPROVAL_ENABLED=1 \
REQUIRE_TELEGRAM_APPROVAL=1 AUTO_OPEN_ON_APPROVE=1 SMART_MANAGE_ON_APPROVE=1 \
TRAIL_ENABLE=1 BE_GUARD_ENABLE=1 PORT=5000 \
gunicorn -c gunicorn_conf.py main:app
'''
waitForPort = 5000

[[workflows.workflow]]
name = "Auto Scanner"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG TRADE_AUTO_SUGGEST=1 SUGGEST_FUTURES=1 SUGGEST_INTERVAL_SEC=60 CONTEXT_URL=https://1f0c42a6-48ab-4140-b304-bba617ce2b45-00-2k2qds7gg7vaz.sisko.replit.dev ALERT_INGEST_URL=https://1f0c42a6-48ab-4140-b304-bba617ce2b45-00-2k2qds7gg7vaz.sisko.replit.dev/alerts/ingest WEBHOOK_HMAC_SECRET=demo_secret_change_in_production python workers/gpt_auto_suggest.py"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Position Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Daily Digest"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto Scanner"

[[workflows.workflow]]
name = "Position Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG ENABLE_POSITION_MONITOR=1 POSITION_REPORT_INTERVAL_SEC=1800 python workers/position_monitor.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Daily Digest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG python workers/daily_digest.py"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33117
externalPort = 3001

[[ports]]
localPort = 43085
externalPort = 3000

[[ports]]
localPort = 45257
externalPort = 3002

# === Deployment (VM Target) ===
[deployment]
deploymentTarget = "vm"
run = ["gunicorn", "-c", "gunicorn_conf.py", "main:app"]
