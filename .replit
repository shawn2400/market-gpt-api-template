modules = ["c-clang14", "cpp-clang14", "bash", "python-3.11", "postgresql-16"]

[agent]
expertMode = true
integrations = ["python_database:1.0.0", "github:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cairo", "cargo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "iproute2", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libyaml", "nettools", "openjpeg", "pkg-config", "qhull", "rustc", "tcl", "tk", "xsimd", "zlib"]

[workflows]
runButton = "Project"

# === Workflow 1: AlgoGPT Server (FastAPI + Gunicorn) ===
[[workflows.workflow]]
name = "AlgoGPT Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "AUTO_RUN=1 EXECUTE_TRADES=1 TRADE_AUTO_SUGGEST=1 SUGGEST_FUTURES=1 ALLOW_MANAGE_OPEN_TRADES=1 PAUSE_AUTO_RUN=0 MANAGER_ENABLE=1 TRADE_MANAGER_ENABLE=1 TELEGRAM_SEND_ENABLE=1 APPROVAL_ENABLED=1 REQUIRE_TELEGRAM_APPROVAL=1 AUTO_OPEN_ON_APPROVE=1 SMART_MANAGE_ON_APPROVE=1 TRAIL_ENABLE=1 BE_GUARD_ENABLE=1 DEBUG_SIGN=1 PORT=5000 gunicorn -c gunicorn_conf.py main:app"
waitForPort = 5000

[[workflows.workflow]]
name = "Auto Scanner"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG TRADE_AUTO_SUGGEST=1 SUGGEST_FUTURES=1 SUGGEST_GRID=1 SUGGEST_INTERVAL_SEC=60 CONTEXT_URL=http://127.0.0.1:5000 ALERT_INGEST_URL=http://127.0.0.1:5000/alerts/ingest WEBHOOK_HMAC_SECRET=demo_secret_change_in_production python workers/gpt_auto_suggest.py"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Daily Digest"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto Scanner"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GPT-5 Central Brain"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AlgoGPT Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "N8N Bridge"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Heartbeat Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Position Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sentinel Security"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Auto-Commit"

[[workflows.workflow]]
name = "Daily Digest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG python workers/daily_digest.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "GPT-5 Central Brain"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG python workers/gpt5_orchestrator.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "N8N Bridge"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG python workers/n8n_bridge.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Heartbeat Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG BASE_URL=http://127.0.0.1:5000 HEARTBEAT_INTERVAL=600 HEARTBEAT_ALERT_LEVEL=critical python workers/system_heartbeat.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Position Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG ENABLE_POSITION_MONITOR=1 POSITION_REPORT_INTERVAL_SEC=1800 POSITION_ALERT_LEVEL=critical python workers/position_monitor.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Sentinel Security"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG SENTINEL_ENABLED=1 SENTINEL_ALERT_LEVEL=critical python workers/sentinel_security.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "GitHub Auto-Commit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG GITHUB_AUTO_COMMIT_ENABLED=1 GITHUB_AUTO_COMMIT_INTERVAL=3600 GITHUB_REPO_PATH=/home/runner/$REPL_SLUG GITHUB_COMMIT_AUTHOR=\"AlgoGPT System\" GITHUB_COMMIT_EMAIL=\"algogpt@system.local\" GITHUB_COMMIT_TELEGRAM_NOTIFY=1 python workers/github_auto_commit.py"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 43085
externalPort = 3000

[[ports]]
localPort = 43365
externalPort = 4200

[[ports]]
localPort = 43433
externalPort = 3002

[[ports]]
localPort = 44553
externalPort = 3001

[[ports]]
localPort = 45313
externalPort = 3003

[[ports]]
localPort = 46675
externalPort = 5000

# === Deployment (VM Target) ===
[deployment]
deploymentTarget = "vm"
run = ["gunicorn", "-c", "gunicorn_conf.py", "main:app"]

[userenv]

[userenv.shared]
AI_MESH_PATH = "ai_mesh.json"
AI_SUP_INTERVAL_SEC = "300"
SUPERVISOR_SYMBOLS = "BTCUSDT,ETHUSDT,SOLUSDT"
OPENAI_SUP_MODEL = "gpt-4o"
AIX_SUP_MODEL = "grok-beta"
SUP_AGREE_STRICT = "1"
SUP_RESTART_GRACE_SEC = "1"
NEWS_ENABLE = "1"
NEWS_MAX_POSTS = "40"
NEWS_POLL_INTERVAL_SEC = "28800"
NEWS_DELTA_NOTIFY_THRESHOLD = "8"
NEWS_SOURCE_CRYPTOPANIC = "1"
NEWS_SOURCE_FEARGREED = "1"
FEARGREED_SOURCE = "alternative"
CRYPTOPANIC_BASE = "https://cryptopanic.com/api/developer/v2"
NEWS_REQ_BUDGET_MONTH = "90"
NEWS_REQ_WINDOW_DAYS = "30"
NEWS_POLL_JITTER_SEC = "90"
NEWS_CB_FAIL_THRESHOLD = "4"
NEWS_CB_COOLDOWN_SEC = "900"
PNL_HEARTBEAT_ENABLE = "1"
PNL_HEARTBEAT_CACHE_SEC = "60"
PNL_HEARTBEAT_WINDOW_TRADES = "50"
PNL_HEARTBEAT_WINDOW_DAYS = "7"
PNL_HEARTBEAT_LOG_PATH = "static/cache/trades_log.json"
OPENAI_BASE = "https://api.openai.com/v1"
AIX_BASE = "https://api.x.ai/v1"
DEEPSEEK_BASE = "https://api.deepseek.com/v1"
NODE_ID = "core-api"
APP_VERSION = "3.6.0"
