modules = ["c-clang14", "cpp-clang14", "bash", "python-3.11", "postgresql-16"]

[agent]
expertMode = true
integrations = ["python_database:1.0.0", "github:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cairo", "cargo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "iproute2", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libyaml", "nettools", "openjpeg", "pkg-config", "postgresql", "qhull", "rustc", "tcl", "tk", "xsimd", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto Health Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Fills Watcher"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GPT-5 Central Brain"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Position Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sentinel Security"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Digest Reporter"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto Cleanup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Auto Scanner"

[[workflows.workflow]]
name = "Auto Health Monitor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG BASE_URL=http://127.0.0.1:5000 HEALTH_CHECK_INTERVAL=30 AUTO_FIX_ENABLE=1 TELEGRAM_SEND_ENABLE=1 python workers/auto_health_monitor.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Fills Watcher"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG FILLS_WATCH_ENABLE=1 FILLS_WATCH_INTERVAL_SEC=15 python workers/fills_watcher.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "GPT-5 Central Brain"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG python workers/gpt5_orchestrator.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Position Monitor"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG ENABLE_POSITION_MONITOR=1 ENABLE_AUTO_PROTECT=1 POSITION_REPORT_INTERVAL_SEC=1800 AUTO_PROTECT_INTERVAL_SEC=30 POSITION_ALERT_LEVEL=all python workers/position_monitor.py"

[[workflows.workflow]]
name = "Sentinel Security"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG SENTINEL_ENABLED=1 SENTINEL_ALERT_LEVEL=critical python workers/sentinel_security.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Telegram Digest Reporter"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG python workers/telegram_digest_reporter.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Auto Cleanup"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG CLEANUP_INTERVAL_SEC=21600 LOGS_RETENTION_DAYS=7 AI_REVIEWS_KEEP_COUNT=100 IMPROVEMENTS_RETENTION_DAYS=30 python workers/auto_cleanup.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Auto Scanner"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/$REPL_SLUG && PYTHONPATH=/home/runner/$REPL_SLUG POOL_PER_CYCLE=50 SUGGEST_GRID=1 AUTO_RUN=1 MIN_QUALITY_SCORE=6.0 python workers/gpt_auto_suggest.py"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 43087
externalPort = 3000

[[ports]]
localPort = 43365
externalPort = 4200

[[ports]]
localPort = 43433
externalPort = 3002

[[ports]]
localPort = 44553
externalPort = 3001

[[ports]]
localPort = 45313
externalPort = 3003

# === Deployment (VM Target) ===
[deployment]
deploymentTarget = "vm"
run = ["gunicorn", "-c", "gunicorn_conf.py", "main:app"]

[userenv]

[userenv.shared]
AI_MESH_PATH = "ai_mesh.json"
AI_SUP_INTERVAL_SEC = "300"
SUPERVISOR_SYMBOLS = "BTCUSDT,ETHUSDT,SOLUSDT"
OPENAI_SUP_MODEL = "gpt-4o"
AIX_SUP_MODEL = "grok-beta"
SUP_AGREE_STRICT = "1"
SUP_RESTART_GRACE_SEC = "1"
NEWS_ENABLE = "1"
NEWS_MAX_POSTS = "40"
NEWS_POLL_INTERVAL_SEC = "28800"
NEWS_DELTA_NOTIFY_THRESHOLD = "8"
NEWS_SOURCE_CRYPTOPANIC = "1"
NEWS_SOURCE_FEARGREED = "1"
FEARGREED_SOURCE = "alternative"
CRYPTOPANIC_BASE = "https://cryptopanic.com/api/developer/v2"
NEWS_REQ_BUDGET_MONTH = "90"
NEWS_REQ_WINDOW_DAYS = "30"
NEWS_POLL_JITTER_SEC = "90"
NEWS_CB_FAIL_THRESHOLD = "4"
NEWS_CB_COOLDOWN_SEC = "900"
PNL_HEARTBEAT_ENABLE = "1"
PNL_HEARTBEAT_CACHE_SEC = "60"
PNL_HEARTBEAT_WINDOW_TRADES = "50"
PNL_HEARTBEAT_WINDOW_DAYS = "7"
PNL_HEARTBEAT_LOG_PATH = "static/cache/trades_log.json"
OPENAI_BASE = "https://api.openai.com/v1"
AIX_BASE = "https://api.x.ai/v1"
DEEPSEEK_BASE = "https://api.deepseek.com/v1"
NODE_ID = "core-api"
APP_VERSION = "3.6.0"
