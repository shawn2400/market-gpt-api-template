# ═════════════════════════════════════════════════════════════
# AlgoGPT v10.4.0 - Configuration Template
# ═════════════════════════════════════════════════════════════

# === CORE ENVIRONMENT ===
ENV=production
DEBUG=0
PORT=8008

# === SECURITY ===
JWT_SECRET=CHANGE_THIS_SECRET_NOW
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ALLOW_IP_WHITELIST=0

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/algogpt

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === EXCHANGE ===
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here

# === AI PROVIDERS ===
OPENAI_API_KEY=optional
DEEPSEEK_API_KEY=optional
GEMINI_API_KEY=optional

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id

# === FEATURES ===
AUTO_PILOT_V4_ENABLED=1
SMART_ALERTS_ENABLED=1
AUTO_HEDGE_ENABLED=1
AUTO_SCALER_ENABLED=1
PROFIT_SHARE_ENABLED=1
SELF_HEALING_ENABLED=1

# === AUTO-PILOT SETTINGS ===
AUTO_HEDGE_THRESHOLD=50000
AUTO_SCALER_BOOST_PCT=5
AUTO_SCALER_LOSS_PCT=-3
PROFIT_SHARE_RATE=0.18

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === MONITORING ===
PROMETHEUS_ENABLED=1
GRAFANA_DASHBOARD_URL=http://localhost:3000

# === DEPLOYMENT ===
AUTO_DEPLOY_REQUIRE_APPROVAL=1
AUTO_ROLLBACK_ON_FAILURE=1

# ═════════════════════════════════════════════════════════════
