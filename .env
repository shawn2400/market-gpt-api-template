# =========================
# 🔐 Auth / Security
# =========================
API_BEARER_TOKEN=rnd_xxxxx
ALGOGPT_TOKENS=rnd_xxxxx
SECURITY_ALLOW_ALL=0

# =========================
# ⚙️ Live Trading
# =========================
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
AUTO_RUN=true

# =========================
# 🔎 Scanner / Limits
# =========================
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30

# =========================
# 💵 Risk / Budget
# =========================
MAX_LEVERAGE=35
MAX_TRADE_BUDGET=100
MAX_TRADES_PER_TICK=3

# =========================
# 🟡 Binance Keys
# =========================
BINANCE_API_KEY=your_real_key_here
BINANCE_API_SECRET=your_real_secret_here
BINANCE_TESTNET=false

# =========================
# 🌐 Binance Base URLs
# =========================
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com   # 👈 תאימות מלאה לכל המודולים
BINANCE_FAPI_ALTS=https://fapi1.binance.com,https://fapi2.binance.com,https://fapi3.binance.com
BINANCE_HTTP_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com

# =========================
# 🌐 Binance Client Settings
# =========================
BINANCE_HTTP_TIMEOUT=6.0
BINANCE_MAX_RETRIES=5

# =========================
# 🤖 OpenAI
# =========================
OPENAI_API_KEY=your_real_openai_key_here
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true

# =========================
# 🔄 WS / Price updater
# =========================
WS_UPDATE_INTERVAL=15
PRICE_MONITOR_DISABLE=false
PRICE_WS_FRESH_TTL=20
PRICE_MONITOR_INTERVAL=30

# =========================
# 📊 Anchor Settings
# =========================
BTC_ANCHOR_MODE=soft
BTC_ANCHOR_FRAMES=15m,1h,4h,1d
BTC_ANCHOR_STRONG_TH=70
BTC_ANCHOR_WEAK_TH=55

# =========================
# 📝 Logs
# =========================
LOG_BUFFER_SIZE=500
LOG_LEVEL=INFO

# =========================
# 🌐 Server
# =========================
PORT=10000
WORKERS=0
TIMEOUT=60
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
KEEPALIVE=5

# =========================
# 🗄 Redis
# =========================
REDIS_URL=redis://redis:6379   # 👈 עובד עם docker-compose (שם השירות redis)

# =========================
# ⚡ Performance / Debug
# =========================
LIGHT_MODE=0
SUPPRESS_BINANCE_WARNINGS=1

# =========================
# 📦 API Response Limits
# =========================
RESPONSE_MAX_BYTES=5242880

# =========================
# 🏷 Version
# =========================
ALGOGPT_VERSION=2.14.9



















































































































































