# ============================
# AlgoGPT — Production ENV
# ============================

# ===== Security =====
# שים טוקן אקראי חזק (לא לשתף). אפשר טוקן נוסף לגיבוי.
API_BEARER_TOKEN=rnd_replace_with_secure_token
API_BEARER_TOKEN_ALT=
SECURITY_ALLOW_ALL=0

# ===== Trading Settings =====
AUTO_RUN=true
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
BINANCE_FORCE_HEDGE_MODE=false
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED

DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1

# אופציונלי: תקציב טרייד יחיד / פילטרים
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
TRENDING_ONLY=false

# ===== Binance =====
# IMPORTANT: הקלד את המפתחות *בשורה אחת* ללא מרכאות, וללא רווחים/CR/LF. האורך חייב להיות 64/64.
BINANCE_API_KEY=PASTE_YOUR_64_CHAR_KEY_HERE
BINANCE_API_SECRET=PASTE_YOUR_64_CHAR_SECRET_HERE
BINANCE_TESTNET=false

# חלון קבלה רחב כדי להפחית -1021, מותאם לקליינט שלנו
BINANCE_RECV_WINDOW=20000

# טיונינג לקליינט (httpx)
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7
SUPPRESS_BINANCE_WARNINGS=1

# (לא חובה) Override ל-Base URL אם צריך פרוקסי/סטאב
# BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com

# ===== User Stream / Health =====
# שמירת listenKey חי כל 30 דק' (פחות מ-60 דק' לפי Binance)
LISTENKEY_KEEPALIVE_SEC=1800
# סמלים למעקב מחירים ב-/health_full
HEALTH_SYMBOLS=BTCUSDT,ETHUSDT
HEALTH_PRICE_MAX_AGE=30
PRICE_SCAN_INTERVAL=15
PRICE_SCAN_STAGGER=0.2

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# ===== Redis (optional) =====
REDIS_URL=redis://default:password@localhost:6379

# ===== Runtime =====
LIGHT_MODE=0
PRICE_MONITOR_DISABLE=0
LOG_LEVEL=INFO
PORT=10000
ALGOGPT_VERSION=2.15.8

# Gunicorn/Uvicorn
WORKERS=2
GUNICORN_TIMEOUT=120
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0

# ===== API Surface / Infra =====
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_WINDOW=60
RESPONSE_MAX_BYTES=5242880





















































































































































































