# ===== Auth =====
API_BEARER_TOKEN=rnd_I7f7QQ6JXu55tuqfORcQKBdlxMPK
SECURITY_ALLOW_ALL=0

# ===== Versions =====
ALGOGPT_VERSION=2.14.3
STRATEGY_VERSION=2.14.3

# ===== Live Trading =====
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
ENABLE_AUTO_TRADING=true
AUTO_RUN=false          # השאר false אם WORKERS>1 (ראה הערה למעלה)
WORKERS=2               # אם תעביר AUTO_RUN=true → שנה ל-1

# ===== Scanner / Limits =====
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6
TOP_SYMBOLS=10
TRENDING_ONLY=true
RESPONSE_MAX_BYTES=1048576
SCAN_MAX_LIMIT=20
EXPOSE_LIMITS=true

# ===== Binance =====
BINANCE_API_KEY=********
BINANCE_API_SECRET=********
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false
BINANCE_FORCE_HEDGE_MODE=false
BINANCE_ALLOWED_EGRESS_IPS=<YOUR_PUBLIC_EGRESS_IP>  # חשוב אם הבורסה מוגבלת IP

# ===== Risk / Budget =====
MAX_LEVERAGE=35
MAX_TRADE_BUDGET=100
MAX_TRADES_PER_TICK=3
PRICE_PROTECT_PCT=0.25
PRICE_MAX_AGE_SEC=10
SYMBOL_COOLDOWN_SEC=600

# ===== OpenAI =====
OPENAI_API_KEY=********
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4

# ===== News / Macro =====
CRYPTO_PANIC_API_KEY=89404de8e0...
NEWSAPI_API_KEY=ca0c11d9...
COINMARKETCAP_API_KEY=fe1ea803-...
COINDECK_API_KEY=1b5d33...88d     # ← שים לב לשם
# (אפשר להשאיר COINDESK_API_KEY לצד זה – לא מזיק)

# ===== Misc =====
CORS_ALLOW_ORIGINS=*
PORT=10000
EGRESS_IP_ENDPOINT=https://algogpt-docker.onrender.com/net/ip


























