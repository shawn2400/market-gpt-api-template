# =========================
# ⚙️ Flags
# =========================
AUTO_RUN=false
ENABLE_AUTO_TRADING=false
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false

# =========================
# 🔐 API auth (ל־/scan/top-volume וכו')
# =========================
API_BEARER_TOKEN=rnd_I7f7QQ6JXu55tuqfORcQKBdlxMPK

# =========================
# 🔎 Scanner / Defaults
# =========================
SCAN_INTERVAL=60
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6
MIN_VOLUME=1000000
TOP_SYMBOLS=50
TRENDING_ONLY=false
# מינימום Quote Volume ב־USDT לבחירת סמלים ל־Top Volume (0 = ללא סינון)
TOP_VOLUME_MIN_QV=0

# =========================
# 💵 Price protection
# =========================
PRICE_PROTECT_PCT=0.25
PRICE_MAX_AGE_SEC=10

# =========================
# 📈 Risk limits (תואם utils/risk.py החדשה)
# =========================
MAX_TRADE_BUDGET=100
MAX_LEVERAGE=35
RISK_PER_TRADE_PCT=1.0
DAILY_RISK_LIMIT_PCT=6.0
PORTFOLIO_EXPOSURE_PCT=25.0
MAX_CONCURRENT_TRADES=7
CONF_MIN_SCALE=0.6
CONF_MAX_SCALE=1.4
ATR_LEV_SENSITIVITY=0.9
TSL_TO_BE_FRACTION=0.20

# =========================
# 🧠 Decision Engine Weights (utils/scoring.py)
# =========================
DECISION_W_QUALITY=0.40
DECISION_W_SUCCESS=0.25
DECISION_W_SPEED=0.15
DECISION_W_VOLAT=0.10
DECISION_W_DECORR=0.10

# =========================
# 🗒️ Logging / CORS
# =========================
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# =========================
# 🟡 Binance (להגדיר מפתחות בסביבת ההרצה האמיתית)
# =========================
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false
BINANCE_FORCE_HEDGE_MODE=false
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=

# =========================
# 🤖 OpenAI
# =========================
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4
OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# 🌐 Networking
# =========================
EGRESS_IP_ENDPOINT=https://algogpt-docker.onrender.com/net/ip
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

# =========================
# 🧭 BTC Anchor
# =========================
BTC_ANCHOR_ENFORCE=false
BTC_ANCHOR_STRONG_TH=70
BTC_ANCHOR_WEAK_TH=55
BTC_ANCHOR_FRAMES=15m,1h

# =========================
# 📰 News / Sentiment / Macro (מפתחות חיצוניים)
#  שים כאן את המפתחות שיש לך; אם חסר – השרות יחזיר תשובה ניטרלית (לא יקרוס)
# =========================
# CryptoPanic (לחדשות + סנטימנט; נתמך גם alias CRYPTOPANIC_API_KEY)
CRYPTO_PANIC_API_KEY=
CRYPTOPANIC_API_KEY=
# NewsAPI.org (אופציונלי; אם תחבר בהמשך)
NEWSAPI_API_KEY=
# FRED (St. Louis Fed) – אם תרצה שליפות מאקרו רשמיות
FRED_API_KEY=
# BEA (Bureau of Economic Analysis) – אופציונלי
BEA_API_KEY=
# CoinMarketCap – אופציונלי (סטטוסים/שוקים)
COINMARKETCAP_API_KEY=
# "CoinDeck" אם נדרש (שם כללי; שים את המפתח שלך)
COINDECK_API_KEY=
# Etherscan (אופציונלי, לא נדרש לגרסת on-chain הנוכחית)
ETHERSCAN_API_KEY=

# Cache לחדשות (ברירת מחדל 120 שניות)
CACHE_TTL_NEWS=120

# =========================
# 🖼️ Snapshots / קבצים ציבוריים
#  נדרש כדי להחזיר URL מלא מ־/snapshot/trade
# =========================
PUBLIC_BASE_URL=https://algogpt-docker.onrender.com

# =========================
# ⚙️ Grid (אופציונלי)
# =========================
GRID_CONCURRENCY=16

# =========================
# 🧩 Meta
# =========================
ALGOGPT_VERSION=2.14.0
STRATEGY_VERSION=2.14.0
PORT=10000
























