# ============================
# AlgoGPT — ENV (FINAL, no Telegram token inside file)
# ============================

# --- Core / Security ---
ALGOGPT_VERSION=2.15.8
API_BEARER_TOKEN=rnd_XVyANQbo1mk8Q8nny3kTNDEzKoF7
SECURITY_ALLOW_ALL=0
LOG_LEVEL=INFO
RESPONSE_MAX_BYTES=5242880
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0

# --- Server ---
PORT=10000
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0
WEB_CONCURRENCY=1

# --- Trading defaults ---
AUTO_RUN=true
EXECUTE_TRADES=true
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
TRENDING_ONLY=false
TRENDING_SOURCE=coingecko
MAX_LEVERAGE=35
SYMBOL_COOLDOWN_SEC=600
SCAN_INTERVAL=60
SCAN_MAX_LIMIT=10
PRICE_MONITOR_DISABLE=0
PRICE_MONITOR_INTERVAL=30
PRICE_MAX_AGE_SEC=10
PRICE_WS_FRESH_TTL=20
PRICE_PROTECT_PCT=0.25
MIN_NOTIONAL_USDT=5
DEFAULT_QTY_STEP=0.001
DEFAULT_PRICE_TICK=0.1
LIGHT_MODE=0

# --- Binance (תקן לשורה אחת, בלי גרשיים/שבירות שורה) ---
BINANCE_API_KEY=<TODO_YOUR_64_CHAR_KEY>
BINANCE_API_SECRET=<TODO_YOUR_64_CHAR_SECRET>
BINANCE_TESTNET=false
BINANCE_RECV_WINDOW=45000
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7
SUPPRESS_BINANCE_WARNINGS=1
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_ALLOWED_EGRESS_IPS=52.59.103.54,18.156.158.53,18.156.42.200

# --- Health / Prices ---
LISTENKEY_KEEPALIVE_SEC=1800
HEALTH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HEALTH_PRICE_MAX_AGE=30
PRICE_SCAN_INTERVAL=15
PRICE_SCAN_STAGGER=0.2

# --- OpenAI ---
OPENAI_API_KEY=<TODO_OPENAI_KEY>
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Telegram (ללא הטוקן עצמו) ---
# ADMIN_CHAT_ID ו/או TELEGRAM_CHAT_ID יוגדרו ב-Render (עדיף), אבל אם תרצה לשים בקובץ — אפשר:
# ADMIN_CHAT_ID=
# TELEGRAM_CHAT_ID=
# את הטוקן עצמו לא שמים בקובץ!

# --- Internal signed calls (watchdog -> sink) ---
# את ה-SECRET נשים ב-Render; אם מאוד חייבים לבדוק מקומית, אפשר לשכפל כאן זמנית.
# WEBHOOK_HMAC_SECRET=

# --- URLs (אותו שירות, על פורט 10000) ---
ALERTS_ACTIVE_URL=http://127.0.0.1:10000/alerts/trades/active
ALERTS_UPDATE_URL=http://127.0.0.1:10000/alerts/trades/update
ALERTS_ANALYSIS_URL=http://127.0.0.1:10000/alerts/analysis
ALERTS_INGEST_URL=http://127.0.0.1:10000/alerts/trade-ingest
RISK_QUICK_URL=http://127.0.0.1:10000/risk/quick
CONTEXT_URL=http://127.0.0.1:10000

# --- Watchdog & Digests ---
WATCHDOG_INTERVAL_SEC=20
WATCHDOG_NEAR_PCT=0.25
SL_BE_ON_TP1=1
DIGEST_ENABLED=1
DIGEST_TZ=Asia/Jerusalem
DIGEST_HOUR=9
DIGEST_MINUTE=0
NEAR_PCT_HIGHVOL=0.15
NEAR_PCT_CHOP=0.10
SUPPRESS_CHOP_NEAR=1

# --- Misc (כבר אצלך) ---
EGRESS_IP_ENDPOINT=https://algogpt-docker.onrender.com/net/ip
BEA_API_KEY=C2E63A56-9010-4A9A-BB21-17F354E65A9D
COINDECK_API_KEY=1b5d33960c275fc7a0133e578317eef5556b277c12de69bbc60422d33ef3888d
COINMARKETCAP_API_KEY=fe1ea803-5b17-4043-b11d-8f48da96da82
CRYPTO_PANIC_API_KEY=89404de8e0bb4d6e78e95ed26ff19970cdb8830a
FRED_API_KEY=6e4f2c5277b4aeadb4845c53a469f21b
LUNARCRUSH_API_KEY=7k8ibnqlizosuy30os8qukfggtgmdqovmff2pep2me
NEWSAPI_API_KEY=ca0c11d966574bf896c5af579f618890
PLACE_HOLDER=1
PLACE_HOLDER_=2
PLACE_HOLDER_E=3
PLACE_HOLDER_R=4



























































































































































































