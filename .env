# =========================
# 🔐 Auth / Security
# =========================
API_BEARER_TOKEN=rnd_yourtoken
ALGOGPT_TOKENS=rnd_yourtoken
SECURITY_ALLOW_ALL=0

# =========================
# ⚙️ Live Trading
# =========================
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
AUTO_RUN=true

# =========================
# 🔎 Scanner / Limits
# =========================
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30

# =========================
# 🌐 Binance (Shield)
# =========================
# עדיף להתחיל מדומיין מאוזן:
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_FAPI_ALTS=https://fapi1.binance.com,https://fapi2.binance.com,https://fapi3.binance.com
BINANCE_HTTP_BASE=https://api.binance.com

# Network / Retries
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
SUPPRESS_BINANCE_WARNINGS=1

# Circuit Breaker (מגן כש-WAF מחזיר HTML)
BINANCE_CB_FAILS_FOR_OPEN=3
BINANCE_CB_COOLDOWN_SEC=120
BINANCE_CB_MAX_COOLDOWN=600
# אם exchangeInfo נחסם – לא עוצרים את המערכת
BINANCE_SOFT_ALLOW_EXCHANGE_INFO=1

# =========================
# 🔑 Binance Keys (שים אמיתיים לפני פרודקשן)
# =========================
BINANCE_API_KEY=your_real_binance_key
BINANCE_API_SECRET=your_real_binance_secret
BINANCE_TESTNET=false

# =========================
# 🤖 OpenAI
# =========================
OPENAI_API_KEY=your_real_openai_key
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true

# =========================
# 🗄 Redis
# =========================
REDIS_URL=redis://redis:6379

# =========================
# 🏷 Version
# =========================
ALGOGPT_VERSION=2.15.0

# =========================
# 🧪 Light mode (לבדיקות יציבות בלבד)
# =========================
# LIGHT_MODE=1
# PRICE_MONITOR_DISABLE=1


































































































































































