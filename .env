# =========================
# 🔐 Auth / Security
# =========================
API_BEARER_TOKEN=rnd_xxxxx                # מפתח Bearer להגנה על REST API
ALGOGPT_TOKENS=rnd_xxxxx                  # מפתח משני (לשימוש פנימי / אינטגרציות)
SECURITY_ALLOW_ALL=0                      # 0 = נעול, 1 = לפתוח הכל (לא מומלץ)

# =========================
# ⚙️ Live Trading
# =========================
EXECUTE_TRADES=true                       # הפעלת טריידים אמיתיים
BINANCE_SKIP_ACCOUNT_MUTATIONS=false      # אם true → רק ניתוח, בלי שינויי חשבון
AUTO_RUN=true                             # להריץ סורק אוטומטי ברקע

# =========================
# 🔎 Scanner / Limits
# =========================
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5                     # סף איכות מינימלי לטרייד
TOP_SYMBOLS=30                            # כמות Top Volume Symbols בסריקה

# =========================
# 💵 Risk / Budget
# =========================
MAX_LEVERAGE=35
MAX_TRADE_BUDGET=100                      # תקציב מקס לכל טרייד
MAX_TRADES_PER_TICK=3                     # כמה טריידים אפשר באותו סריקה

# =========================
# 🟡 Binance Keys
# =========================
BINANCE_API_KEY=your_real_key_here
BINANCE_API_SECRET=your_real_secret_here
BINANCE_TESTNET=false                     # true = טסטנט בלבד

# =========================
# 🌐 Binance Base URLs
# =========================
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_FAPI_ALTS=https://fapi1.binance.com,https://fapi2.binance.com,https://fapi3.binance.com
BINANCE_HTTP_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com

# =========================
# 🌐 Binance Client Settings
# =========================
BINANCE_HTTP_TIMEOUT=6.0
BINANCE_MAX_RETRIES=5

# =========================
# 🤖 OpenAI
# =========================
OPENAI_API_KEY=your_real_openai_key_here
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true

# =========================
# 🔄 WS / Price updater
# =========================
WS_UPDATE_INTERVAL=15
PRICE_MONITOR_DISABLE=false
PRICE_WS_FRESH_TTL=20
PRICE_MONITOR_INTERVAL=30

# =========================
# 📊 Anchor Settings
# =========================
BTC_ANCHOR_MODE=soft
BTC_ANCHOR_FRAMES=15m,1h,4h,1d
BTC_ANCHOR_STRONG_TH=70
BTC_ANCHOR_WEAK_TH=55

# =========================
# 📝 Logs
# =========================
LOG_BUFFER_SIZE=500
LOG_LEVEL=INFO

# =========================
# 🌐 Server
# =========================
PORT=10000
WORKERS=0                                # 0 = דינמי לפי CPU (2*CPU + 1)
TIMEOUT=60                               # Gunicorn timeout (שניות)
MAX_REQUESTS=1000                        # recycle workers אחרי X בקשות
MAX_REQUESTS_JITTER=50
KEEPALIVE=5

# =========================
# 🗄 Redis (לא חובה, fallback לזיכרון)
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# ⚡ Performance / Debug
# =========================
LIGHT_MODE=0                             # 1 = מצב קל (disable background tasks)
SUPPRESS_BINANCE_WARNINGS=1              # 1 = הסתרת הצפות לוג של Binance

# =========================
# 📦 API Response Limits
# =========================
RESPONSE_MAX_BYTES=5242880               # 5MB מקסימום לתשובה

# =========================
# 🏷 Version
# =========================
ALGOGPT_VERSION=2.14.9















































































































































