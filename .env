# ---------- Core ----------
APP_MODULE=main:app
PUBLIC_HOST=https://algogpt-docker.onrender.com
LOG_LEVEL=INFO
ENV=prod
PORT=10000

# ---------- Auth ----------
AUTH_ALLOW_ALL=0
API_BEARER_TOKEN=PUT_API_BEARER_TOKEN
# אם יש לך כמה טוקנים, אפשר להשתמש גם ב:
# AUTH_TOKENS=token1,token2,token3

# ---------- CORS ----------
CORS_ALLOW_CREDENTIALS=0
CORS_ALLOW_ORIGINS=https://algogpt-docker.onrender.com

# ---------- Public routes (תואם main.py) ----------
SECURITY_PUBLIC_PATHS=/ops/approve-link,/ops/approve,/ops/reject,/ops/approve/signed,/telegram/ping,/trade/approve,/trade/reject,/ops/manager/health,/ops/ui,/ops/ui/ticket,/ui/dashboard
SECURITY_PUBLIC_PREFIXES=/public,/price,/static,/risk

# ---------- DB / Redis ----------
DATABASE_URL=sqlite:////app/data/algogpt.db
REDIS_URL=PUT_REDIS_URL

# ---------- Binance ----------
BINANCE_API_KEY=PUT_BINANCE_API_KEY
BINANCE_API_SECRET=PUT_BINANCE_API_SECRET
BINANCE_TESTNET=false
POSITION_MODE_OVERRIDE=hedge
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_HTTP_TIMEOUT=10.0
BINANCE_RECV_WINDOW=45000
BINANCE_MAX_RETRIES=2
BINANCE_WORKING_TYPE=MARK_PRICE
BINANCE_TIME_SYNC_INTERVAL_SEC=900

# ---------- OpenAI ----------
OPENAI_BASE=https://api.openai.com
OPENAI_API_KEY=PUT_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# ---------- Telegram ----------
ADMIN_CHAT_ID=449087907
TELEGRAM_ADMIN_IDS=449087907
TELEGRAM_ADMIN_ONLY=1
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=PUT_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_CHAT_ID=449087907
TELEGRAM_AUTO_WEBHOOK=1
TELEGRAM_PARSE_MODE=HTML

# ---------- Trading: execution & approvals ----------
EXECUTE_TRADES=1
APPROVAL_ENABLED=1
SINK_ENFORCE_APPROVALS=1
AUTO_OPEN_ON_APPROVE=1
APPROVAL_REQUIRE_FRESH_PRICE=1
APPROVAL_RR_MIN=1.30
APPROVAL_SUCCESS_MIN=60
APPROVAL_MAX_SL_PCT=3.0
CONFIRM_TTL_SEC=120
OPS_TICKET_TTL_SEC=1800
OPS_DIGEST_INTERVAL_HOURS=3

# ---------- Scanner / symbols ----------
DEFAULT_MARKET=futures
DEFAULT_INTERVAL=1m
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
TOP_SYMBOLS=30
SCAN_INTERVAL=60
SCAN_MAX_LIMIT=10
SYMBOL_COOLDOWN_SEC=600
SYMBOL_ERROR_COOLDOWN_SEC=180
SYMBOL_ERROR_QUARANTINE_HIT=3

# ---------- Risk & guards (ספים שמרניים ומספקים) ----------
ENTRY_BAND_BPS=10
STOP_BAND_BPS=12
PERCENT_GUARD_ENABLE=1
PERCENT_PRICE_GUARD_BPS=45
POST_FILL_SANITY_BPS=50
SLIPPAGE_GUARD_BPS=80
MIN_NOTIONAL_USDT=5
MAX_ATR_PCT=3.0
MIN_QUALITY_SCORE=7
FEAT_QUALITY_ENFORCE=1
FEAT_SPREAD_DEPTH=1
# הסרת SOP_* (לא נדרש)

# ---------- Trailing & ladders ----------
TRAIL_ENABLE=1
FORCE_TRAIL_ONLY=0
TRAIL_ATR_MULT=1.5
TRAIL_FREEZE_ENABLE=1
TRAIL_CALLBACK_MIN_PCT=0.1
TRAIL_CALLBACK_MAX_PCT=4.9

LADDER_TP_ENABLE=1
LADDER_TP_KIND=TAKE_PROFIT
LADDER_TP_DEFAULT_PCTS=1.8,3.2,5.5
LADDER_TP_DEFAULT_SPLITS=0.4,0.35,0.25
LADDER_SL_ENABLE=1
LADDER_SL_DEFAULT_PCTS=1.2

# ---------- Leverage policy ----------
LEVERAGE_SYMBOL_CAPS={"BTCUSDT":15,"1000PEPEUSDT":8}
LEV_ADX_MAP_JSON={"30":15,"25":12,"20":9,"0":7}
LEV_HARD_CAP=50
MIN_LEVERAGE=5
MAX_LEVERAGE=35

# ---------- Manager / ops ----------
MANAGER_ENABLE=1
MANAGER_INTERVAL_SEC=10
OPS_HEARTBEAT_ENABLE=1
OPS_HEARTBEAT_EVERY_MIN=5
OPS_POLICY_PATH=policies/ops_policy.yaml

# ---------- Misc ----------
PRICE_SCAN_INTERVAL=30
PRICE_MAX_AGE_SEC=15
PRICE_CACHE_TTL_MS=250
READONLY_ENDPOINTS=summary,prices_top,news_cache,health
RESPONSE_MAX_BYTES=5242880
UVICORN_ACCESS_LOG=false
UVICORN_LOG_LEVEL=info






























































































































































































































































































































































































































































