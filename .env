# =========================
# Core / Security
# =========================
ALGOGPT_VERSION=2.17.0
SECURITY_ALLOW_ALL=0
LOG_LEVEL=INFO
RESPONSE_MAX_BYTES=5242880
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0

# Auth
API_BEARER_TOKEN=rnd_XVyANQbo1mk8Q8nny3kTNDEzKoF7
ALGOGPT_TOKENS=rnd_XVyANQbo1mk8Q8nny3kTNDEzKoF7

# Admin
ADMIN_CHAT_ID=449087907
TELEGRAM_ADMIN_IDS=449087907
PAUSE_AUTO_RUN=0

# =========================
# Server
# =========================
PORT=10000
BIND_HOST=0.0.0.0
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0
WEB_CONCURRENCY=1
WORKERS=2
WEBHOOK_HOST=https://algogpt-docker.onrender.com

# =========================
# Trading defaults
# =========================
AUTO_RUN=true
EXECUTE_TRADES=true
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=8.5
QUALITY_MIN_SCORE=8.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
TRENDING_ONLY=false
TRENDING_SOURCE=coingecko
MAX_LEVERAGE=35
MIN_LEVERAGE=5
SYMBOL_COOLDOWN_SEC=600
SCAN_INTERVAL=60
SCAN_MAX_LIMIT=10
PRICE_MONITOR_DISABLE=0
PRICE_MONITOR_INTERVAL=60
PRICE_MAX_AGE_SEC=10
PRICE_WS_FRESH_TTL=20
DEFAULT_VOL_REGIME=mid

# =========================
# Scanner perf / throttling
# =========================
SCAN_CONCURRENCY=4
SCAN_TIME_BUDGET_SEC=7.5

# =========================
# Live management
# =========================
ALLOW_MANAGE_OPEN_TRADES=true

# =========================
# Watchlist / WS
# =========================
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INDICATOR_INTERVALS=15m,1h
SYMS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED

# =========================
# Binance (HTTP/WS)
# =========================
BINANCE_API_KEY=PUT_BINANCE_API_KEY_64CH
BINANCE_API_SECRET=PUT_BINANCE_SECRET_64CH
BINANCE_TESTNET=false
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_WORKING_TYPE=MARK_PRICE
BINANCE_PRICE_PROTECT=false
BINANCE_RECV_WINDOW=45000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
TIME_SYNC_TIMEOUT_SEC=3.0
TIME_SYNC_SKEW_LIMIT_MS=2000
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=100
HTTP_CONCURRENCY=32
ORDERS_QPS_BUCKET=8
ORDERS_BUCKET_WINDOW_SEC=10
ORDER_BACKOFF_BASE_MS=80
ORDER_BACKOFF_MAX_MS=1200
SUPPRESS_BINANCE_WARNINGS=1
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
BINANCE_FORCE_HEDGE_MODE=false

# =========================
# HTTP Circuit Breaker
# =========================
CB_WINDOW_SEC=30
CB_FAIL_THRESHOLD=6
CB_OPEN_SEC=20

# =========================
# Health / Prices
# =========================
LISTENKEY_KEEPALIVE_SEC=1800
HEALTH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HEALTH_PRICE_MAX_AGE=30
PRICE_SCAN_INTERVAL=15
WS_KEEPALIVE_SEC=25

# =========================
# ExchangeInfo Fallbacks
# =========================
DEFAULT_QTY_STEP=0.001
DEFAULT_PRICE_TICK=0.1
MIN_NOTIONAL_USDT=5
EXCHANGE_INFO_TTL_SEC=900

# =========================
# SOP / Gates
# =========================
FEAT_BTC_GATE=0
FEAT_TF_ALIGN=0
FEAT_SPREAD_DEPTH=0
FEAT_MARK_INDEX_SANITY=0
FEAT_VOLUME_GATE=0
FEAT_PUMP_NUKE=0
FEAT_QUALITY_ENFORCE=0
FEAT_DAILY_CAPS=0
FEAT_COOLDOWN=0
FEAT_DEBOUNCE_LIMIT=0
SOP_MAX_SPREAD_BPS=3.0
SOP_MIN_TOP_QTY=0
SOP_MARK_INDEX_MAX_GAP_BPS=20.0
SOP_PUMP_NUKE_MAX_5M_PCT=1.0
SOP_VOLUME_MIN_RATIO=1.2

# =========================
# Approvals / Preflight
# =========================
APPROVAL_ENABLED=1
APPROVAL_EARLY_AI=1
PROPOSE_BLOCK_ON_FAIL=0
SINK_ENFORCE_APPROVALS=1
APPROVAL_REQUIRE_WATCHLIST=1
APPROVAL_SUCCESS_MIN=60
APPROVAL_RR_MIN=1.30
MIN_TP_SL_DIFF_PCT=0.15
APPROVAL_MAX_SL_PCT=3.0
APPROVAL_DUP_COOLDOWN_SEC=300

# =========================
# OpenAI
# =========================
ENABLE_AI_ROUTES=true
OPENAI_API_KEY=PUT_OPENAI_KEY
OPENAI_MODEL=gpt-4o
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_BASE_URL=https://api.openai.com/v1

# =========================
# Redis (optional)
# =========================
REDIS_URL=redis://USER:PASS@HOST:6379
REDIS_NAMESPACING=algogpt:v2

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=PUT_TELEGRAM_WEBHOOK_SECRET
TG_NOTIFY_RECONCILE=1
TG_NOTIFY_GRID=1
TG_NOTIFY_MANAGER=0
PUBLIC_FEED_CHANNEL_ID=-1001234567890
ENABLE_PUBLIC_FEED=1

# =========================
# Alerts / Sink endpoints
# =========================
ALERTS_ACTIVE_URL=https://algogpt-docker.onrender.com/alerts/trades/active
ALERTS_UPDATE_URL=https://algogpt-docker.onrender.com/alerts/trades/update
ALERTS_ANALYSIS_URL=https://algogpt-docker.onrender.com/alerts/analysis
ALERTS_INGEST_URL=https://algogpt-docker.onrender.com/alerts/trade-ingest
RISK_QUICK_URL=https://algogpt-docker.onrender.com/risk/quick

# =========================
# AI Suggest Queue / Scheduler
# =========================
AI_QUEUE_TO_TELEGRAM=1
AI_QUEUE_AUTO_EXECUTE=0
AI_SCHED_ENABLE=0
AI_SCHED_INTERVAL_SEC=300

# =========================
# User-Data Stream
# =========================
STREAM_WS_KEEPALIVE_SEC=25
ORDER_EVENT_RATE_LIMIT=15
STREAM_TP_BE=true
TP_LOCK_STAGE2_ATR=0.5

# =========================
# Grid TP
# =========================
GRID_ENABLE=true
GRID_TP1_ATR=1.0
GRID_TP2_ATR=1.8
GRID_TP3_ATR=2.6
GRID_SPLIT_1=0.33
GRID_SPLIT_2=0.33
GRID_SPLIT_3=0.34

# =========================
# Manager logic / Chop detection
# =========================
CHOP_DETECT_ENABLE=true
CHOP_ADX_MAX=18
CHOP_MACD_HIST_ABS_MAX=0.05
CHOP_BB_WIDTH_PCT_MAX=0.9
CHOP_MIN_BARS=6
CHOP_TIME_LIMIT_MIN=45
CHOP_ACTION=to_breakeven
CHOP_PARTIAL_PCT=0.33
BE_ARM_PCT=1.6
TRAIL_ATR_MULT=1.5
MOMENTUM_LOCK_MIN_BARS=3
MANAGER_COOLDOWN_SEC=45

# =========================
# Reconcile / cleanup
# =========================
GRID_STATE_CLEANUP_TTL_SEC=86400
TELEGRAM_ADMIN_ONLY=1






































































































































































































