# 🔐 Auth
API_BEARER_TOKEN=GrwpXpkRWunC7SPZGFrhaizBwcaZzpWLYJ9kv4W7u6aTx_EXu0VGfpBKaBhThLD2

# ⚙️ App Flags (מצב ידני–חי: אין אוטומציה, יש יכולת למסחר LIVE לפי קריאה מפורשת)
AUTO_RUN=false
ENABLE_AUTO_TRADING=false
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false

# 🔎 Scanner / Defaults
SCAN_INTERVAL=60
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6
MIN_VOLUME=1000000
TOP_SYMBOLS=30
TRENDING_ONLY=false

# 💵 Price protection
PRICE_PROTECT_PCT=0.25
PRICE_MAX_AGE_SEC=10

# 📈 Risk limits
MAX_TRADE_BUDGET=100
MAX_LEVERAGE=35

# 🗒️ Logging / CORS
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# 🟡 Binance (שים מפתחות אמיתיים ב-Render Environment בלבד!)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false
BINANCE_FORCE_HEDGE_MODE=false
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=

# ⏱️ Time sync thresholds (ליציבות חתימה)
TIME_SYNC_MAX_RTT_MS=800
TIME_SYNC_MAX_ABS_OFFSET_MS=1500

# 🤖 OpenAI (אל תשמור מפתח בקובץ; הגדר ב-Render Environment)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4
OPENAI_BASE_URL=https://api.openai.com/v1

# 🌐 Networking (Allowlist חייב לכלול את הכתובות האלו ב-Binance)
EGRESS_IP_ENDPOINT=https://algogpt-docker.onrender.com/net/ip
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

# 🧩 Versions / Meta
ALGOGPT_VERSION=2.13.4
STRATEGY_VERSION=2.13.4
GIT_COMMIT=
REQ_HASH=

# 🚪 Server
PORT=10000

# 🧭 BTC Anchor (משוקלל בלבד – לא חוסם)
BTC_ANCHOR_ENFORCE=false
BTC_ANCHOR_STRONG_TH=70
BTC_ANCHOR_WEAK_TH=55
BTC_ANCHOR_FRAMES=15m,1h

















