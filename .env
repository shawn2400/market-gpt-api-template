# ============ App ============
APP_NAME=algogpt
APP_TITLE=AlgoGPT Service (production)
ALGOGPT_VERSION=2.18.0
MODE=hybrid
PORT=10000
APP_MODULE=main:app
PYTHONPATH=/app

# Public / URLs
PUBLIC_HOST=https://algogpt-docker.onrender.com
CONTEXT_URL=https://algogpt-docker.onrender.com
WEBHOOK_HOST=https://algogpt-docker.onrender.com

# Docs
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
OPENAPI_HIDE_PATTERNS=/_debug/*,/debug/*,/internal/*,/provider/*,/grid/*,/trade/*,/risk/*/internal*
OPENAPI_PUBLIC_MAX_OPS=30
ENABLE_READONLY_HTTP=1
READONLY_ENDPOINTS=

# CORS
CORS_ALLOW_ORIGINS=https://algogpt-docker.onrender.com
CORS_ALLOW_ORIGINS_STRICT=https://algogpt-docker.onrender.com
CORS_ALLOW_HEADERS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_CREDENTIALS=0

# Security
PROTECT_APPROVE_ROUTES=1
PROTECT_DIGEST_ROUTES=1
PROTECT_DEBUG_ROUTES=1
ENABLE_HSTS=1
TRUST_PROXY=1
ENABLE_CSP=1
CSP_POLICY=default-src 'none'; img-src 'self' data: https:; style-src 'unsafe-inline' 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; connect-src 'self' https: wss:; base-uri 'none'; frame-ancestors 'none'
SECURITY_PUBLIC_PATHS=/healthz,/readyz,/version,/scan/public-now,/scan/public-topk,/scan/public-stream,/topk,/ops/ui/ticket/signed,/ops/approve/signed,/ops/reject/signed,/public/ticket/inspect,/public/pos-events/stream,/ops/manager/health,/ui/snapshot,/ui/snapshot/idle
SECURITY_PUBLIC_PREFIXES=/public,/price,/static,/risk,/ultra
SECURITY_PROTECTED_PATHS=/webhook/whatever,/guard/smoke/run,/ops/pending.json,/admin,/manage-once,/manage-once/multi

# Anti-replay / Signature
ANTI_REPLAY_ENABLE=1
ANTI_REPLAY_REQUIRE_SIGNATURE=1
ANTI_REPLAY_NONCE_TTL_SEC=180
SIG_TS_ENFORCE=1
SIG_TS_SKEW_SEC=900

# Rate limits
RATE_LIMIT_ENABLE=1
RL_FAIL_OPEN=0
RATE_LIMIT_BACKEND=memory
PUBLIC_TOPK_RPS=2
PUBLIC_TOPK_WINDOW=3
PUBLIC_NOW_RPS=2
PUBLIC_NOW_WINDOW=3
PUBLIC_CACHE_MAX_AGE=20
PUBLIC_CACHE_PATHS=/scan/public-topk,/scan/public-now,/topk
PUBLIC_WEB_RPS=2
PUBLIC_WEB_BURST=6
PUBLIC_REST_RPS=5
PUBLIC_REST_BURST=15
PUBLIC_SSE_MAX_CONNS=40
PUBLIC_SSE_MAX_CONNS_PER_IP=3
PUBLIC_RL_NS=ops-supervisor-web:rl:prod

# Runtime / Gunicorn
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=45
GUNICORN_KEEPALIVE=30
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
LOG_LEVEL=INFO
UVICORN_ACCESS_LOG=false
UVICORN_LOG_LEVEL=info
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=50

# DB / Disk
DATABASE_URL=sqlite:////app/data/algogpt.db
SQLITE_PATH=/app/data/state.db

# Binance / Market
DEFAULT_MARKET=futures
POSITION_MODE_OVERRIDE=hedge
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_TESTNET=false
BINANCE_WORKING_TYPE=MARK_PRICE
BINANCE_HTTP_TIMEOUT=10.0
BINANCE_MAX_RETRIES=2
BINANCE_RECV_WINDOW=45000
LISTENKEY_KEEPALIVE_SEC=1800
WS_KEEPALIVE_SEC=25
USE_WS=1
USER_STREAM_ENABLE=1
EXCHANGE_INFO_TTL_SEC=900

# Scanning / Indicators (ערכים שמישים)
SCAN_SOURCE=binance-futures
UNIVERSE_MODE=exchange
SCAN_INTERVALS=5m,15m,1h,4h
SCAN_MAX_SYMBOLS=80
SCAN_CONCURRENCY=1
TOP_SYMBOLS=40
SUGGEST_FUTURES=1
SUGGEST_INTERVAL_SEC=60
SUGGEST_CAP_PER_CYCLE=15
SCAN_AUTOTICKET_ENABLE=1
SCAN_NOTIFY_TELEGRAM=0
INDICATOR_INTERVALS=15m,1h,4h,1d
ENABLE_INDICATOR_EXIT=1
ADX_MIN=20
MAX_ATR_PCT=3
FEAT_TF_ALIGN=1
FEAT_VOLUME_GATE=1
FEAT_QUALITY_ENFORCE=1
ENTRY_SCORE_MODE=log
ENTRY_SCORE_MIN=0
ENTRY_SCORE_INTERVAL=15m
REGIME_ADX_TREND=22
REGIME_CHOP_ATR=0.6
REGIME_COMPRESSION_BW=1.2
EMA_GAP_MAX_PCT=6
IMPACT_SLIP_BPS_MAX=25

# Approvals / Ops
APPROVAL_ENABLED=1
REQUIRE_TELEGRAM_APPROVAL=1
AUTO_OPEN_ON_APPROVE=1
ALLOW_MARKET_ENTRY=1
APPROVAL_REQUIRE_FRESH_PRICE=0
CONFIRM_TTL_SEC=600
PROPOSE_BLOCK_ON_FAIL=1
APPROVAL_RR_MIN=0
APPROVAL_SUCCESS_MIN=0
APPROVAL_DUP_COOLDOWN_SEC=0
OPS_TICKET_TTL_SEC=900

# Orders / Risk misc
EXECUTE_TRADES=1
MANAGER_WRITES_ORDERS=1
ORDERS_USE_OCO=1
ORDER_ID_PREFIX=ALG
ORDER_ID_INCLUDE_TS=1
ORDER_BACKOFF_BASE_MS=120
ORDER_BACKOFF_MAX_MS=1600
ORDER_ROUND_TO_TICK=1
USE_EXCHANGE_FILTERS=1
ORD_VERIFY_TIMEOUT_MS=800
ORD_CANCEL_STRATEGY=MINIMAL
MAX_TRADES_PER_TICK=1
MIN_NOTIONAL_USDT=5
MAX_TRADE_BUDGET=200
ORDER_TRIGGER=mark
POST_ONLY=0

# Auto qty / leverage / budget
AUTO_QTY_ENABLE=1
AUTO_QTY_MODE=notional
AUTO_QTY_MARGIN_BUFFER_PCT=0.15
AUTO_LEV_MIN=20
AUTO_LEV_MAX=35
AUTO_BUDGET_MIN=100
AUTO_BUDGET_MAX=200

# SL/TP / trailing / BE (תואם ה־SOP שלך)
NATIVE_TPSL_ENABLE=1
SL_MONOTONIC=1
STRUCT_SL_ENABLE=1
STRUCT_SL_LOOKBACK=50
STRUCT_SL_LEFT=3
STRUCT_SL_RIGHT=3
STRUCT_SL_BUFFER_BPS=3
STRUCT_SL_MERGE_MODE=tight
TP_BE_OFFSET_BPS=12
TRAIL_ENABLE=1
TRAIL_ATR_MULT=1.6
ATR_UPDATE_COOLDOWN_SEC=20
ATR_MIN_DELTA=0.02
HYSTERESIS_ATR_FRAC=0.2
SL_MIN_STEP_BPS=3
BE_ARM_PCT=0.45
BE_GUARD_ENABLE=1
BE_GUARD_EVERY_SEC=20
BE_TRIGGER_REQUIRE_ADX=20
BE_TRIGGER_PROG_TO_TP1_PCT=0.35
PROG_TO_TP1_FALLBACK_PCT=0.60
TP_SL_REFRESH_SEC=60
MANAGER_REISSUE_ENABLE=1
MANAGER_REISSUE_POLICY=cancel_replace

# BTC Gate
BTC_GATE_ENABLE=1
BTC_GATE_TF=15m
BTC_LONG_REQ=ema21>=ema50
BTC_SHORT_REQ=ema21<=ema50

# Health / Readiness
READINESS_CHECK_BINANCE=1
READINESS_CHECK_SQLITE=0
READINESS_FAIL_GRACE_SEC=5
READINESS_BINANCE_RETRY=1
HEALTH_ALERTS_ENABLE=1
HEALTH_ALERTS_COOLDOWN_SEC=120
HEALTH_PRICE_MAX_AGE=30
HEALTH_TP_GRACE_SEC=8

# Metrics
PROM_METRICS_ENABLE=1
PROM_METRICS_PATH=/metrics
METRICS_PROTECT=1
PUBLIC_METRICS_REQUIRE_BEARER=1
HTTP_LATENCY_BUCKETS=0.05,0.1,0.25,0.5,1,2,5
TP1_TIME_BUCKETS=30,60,120,300,600,1200,3600
SLIP_BPS_BUCKETS=1,2,5,10,20,50,100

# Telegram (בלי סודות)
ADMIN_CHAT_ID=449087907
TELEGRAM_AUTO_WEBHOOK=1
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_RICH_MSG=0
TELEGRAM_SEND_ENABLE=1

# Manager
MANAGER_ENABLE=1
TRADE_MANAGER_ENABLE=1
MANAGER_INTERVAL_SEC=20
ALLOW_MANAGE_OPEN_TRADES=1

# Watchlist
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,NEARUSDT


































































































































































































































































































































































































































































