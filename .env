# --- Auth / Tokens ---
API_BEARER_TOKEN=rnd_xxxxx
ALGOGPT_TOKENS=rnd_xxxxx
SECURITY_ALLOW_ALL=0

# --- Trading ---
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
AUTO_RUN=true

# --- Scanner ---
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30

# --- Risk / Budget ---
MAX_LEVERAGE=35
MAX_TRADE_BUDGET=100
MAX_TRADES_PER_TICK=3

# --- Binance (Proxy) ---
BINANCE_API_KEY=your_real_key_here
BINANCE_API_SECRET=your_real_secret_here
BINANCE_TESTNET=false

BINANCE_FAPI_BASE=https://market-gpt-api-template.vercel.app/api/proxy/fapi
BINANCE_HTTP_BASE=https://market-gpt-api-template.vercel.app/api/proxy/api
BINANCE_FALLBACK_URL=https://market-gpt-api-template.vercel.app/api/proxy

BINANCE_WS_BASE=wss://market-gpt-api-template.vercel.app/api/proxy/ws?target=wss://stream.binance.com:9443
BINANCE_FUTURES_WS_BASE=wss://market-gpt-api-template.vercel.app/api/proxy/ws?target=wss://fstream.binance.com

BINANCE_HTTP_TIMEOUT=6.0
BINANCE_MAX_RETRIES=5

# --- OpenAI ---
OPENAI_API_KEY=your_real_openai_key_here
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true

# --- Redis ---
REDIS_URL=redis://red-d2j4vf2li9vc73evhv4g:6379

# --- Server ---
PORT=10000
WORKERS=2
TIMEOUT=60
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
KEEPALIVE=5

# --- Logs ---
LOG_LEVEL=INFO
LOG_BUFFER_SIZE=500

# --- Performance ---
LIGHT_MODE=0
SUPPRESS_BINANCE_WARNINGS=1

# --- Response Limits ---
RESPONSE_MAX_BYTES=5242880

# --- Version ---
ALGOGPT_VERSION=2.15.0

























































































































































