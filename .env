# ============================
# LOCAL DEV TEMPLATE ONLY
# Production on Render ignores this file.
# ============================

# --- Security ---
API_BEARER_TOKEN=
SECURITY_ALLOW_ALL=0

# --- Trading Settings ---
AUTO_RUN=false                 # ידני בפיתוח מקומי
EXECUTE_TRADES=false           # אל תשלח פקודות אמיתיות מקומית
BINANCE_SKIP_ACCOUNT_MUTATIONS=false

DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1

# --- Binance Keys (השאר ריק מקומית; ב-Render יש ממשי) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# --- OpenAI (השאר ריק מקומית; ב-Render יש ממשי) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# --- Redis ---
REDIS_URL=redis://default:password@localhost:6379

# --- Runtime ---
LIGHT_MODE=0                  # 0 = הפעלת תהליכי רקע (price/anchor)
PRICE_MONITOR_DISABLE=0
LOG_LEVEL=INFO
PORT=10000
ALGOGPT_VERSION=2.15.0
















































































































































































