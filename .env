# =========================
# Core / Security
# =========================
ALGOGPT_VERSION=2.18.0
SECURITY_ALLOW_ALL=0
LOG_LEVEL=INFO
RESPONSE_MAX_BYTES=5242880
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0

# Auth - CHANGE THESE IN PRODUCTION
API_BEARER_TOKEN=demo_token_change_in_production
ALGOGPT_TOKENS=demo_token_change_in_production

# Admin
ADMIN_CHAT_ID=0
TELEGRAM_ADMIN_IDS=0
TELEGRAM_ADMIN_ONLY=0
PAUSE_AUTO_RUN=1

# =========================
# Server - Replit Config
# =========================
PORT=5000
BIND_HOST=0.0.0.0
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0
WEB_CONCURRENCY=1
WORKERS=1
PUBLIC_HOST=

# =========================
# Trading defaults (DISABLED FOR DEMO)
# =========================
AUTO_RUN=false
EXECUTE_TRADES=false
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=8.5
QUALITY_MIN_SCORE=8.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
MAX_LEVERAGE=35
MIN_LEVERAGE=5
SYMBOL_COOLDOWN_SEC=600
SCAN_INTERVAL=90
SCAN_MAX_LIMIT=10
DEFAULT_VOL_REGIME=mid

# =========================
# Scanner perf / throttling
# =========================
SCAN_CONCURRENCY=4
SCAN_TIME_BUDGET_SEC=7.5

# =========================
# Live management
# =========================
ALLOW_MANAGE_OPEN_TRADES=true

# =========================
# Watchlist / WS
# =========================
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INDICATOR_INTERVALS=15m,1h
SYMS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED

# =========================
# Binance (DEMO - NOT SET)
# =========================
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_WORKING_TYPE=MARK_PRICE
BINANCE_PRICE_PROTECT=false
BINANCE_RECV_WINDOW=45000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
TIME_SYNC_TIMEOUT_SEC=3.0
TIME_SYNC_SKEW_LIMIT_MS=2000
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=100
HTTP_CONCURRENCY=32
ORDERS_QPS_BUCKET=8
ORDERS_BUCKET_WINDOW_SEC=10
ORDER_BACKOFF_BASE_MS=80
ORDER_BACKOFF_MAX_MS=1200
SUPPRESS_BINANCE_WARNINGS=1
BINANCE_SKIP_ACCOUNT_MUTATIONS=true
BINANCE_FORCE_HEDGE_MODE=false

# =========================
# OpenAI (DEMO - NOT SET)
# =========================
ENABLE_AI_ROUTES=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# =========================
# Redis (optional)
# =========================
REDIS_URL=
REDIS_NAMESPACING=algogpt:v2
REQUIRE_REDIS=0

# =========================
# Telegram (DEMO - NOT SET)
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_HMAC_SECRET=
TG_NOTIFY_RECONCILE=0
TG_NOTIFY_GRID=0
TG_NOTIFY_MANAGER=0
PUBLIC_FEED_CHANNEL_ID=
ENABLE_PUBLIC_FEED=0
TELEGRAM_AUTO_WEBHOOK=0

# =========================
# Feature Flags (Safe defaults)
# =========================
FEAT_BTC_GATE=1
FEAT_TF_ALIGN=1
FEAT_SPREAD_DEPTH=1
FEAT_MARK_INDEX_SANITY=1
FEAT_VOLUME_GATE=1
FEAT_PUMP_NUKE=1
FEAT_QUALITY_ENFORCE=1
FEAT_DAILY_CAPS=1
FEAT_COOLDOWN=1
FEAT_DEBOUNCE_LIMIT=1

# =========================
# Approvals / Preflight
# =========================
APPROVAL_ENABLED=1
APPROVAL_EARLY_AI=0
SINK_ENFORCE_APPROVALS=1
APPROVAL_REQUIRE_WATCHLIST=1
APPROVAL_SUCCESS_MIN=60
APPROVAL_RR_MIN=1.30
MIN_TP_SL_DIFF_PCT=0.15
APPROVAL_MAX_SL_PCT=3.0
APPROVAL_DUP_COOLDOWN_SEC=300
PROPOSE_BLOCK_ON_FAIL=0

# Protection routes
PROTECT_APPROVE_ROUTES=0

# OPS Sign Secret
OPS_SIGN_SECRET=demo_secret_change_in_production

# ================================================================================
# PROGRESSIVE ROLLOUT - PHASE 3: FULL PRODUCTION (ALL SYMBOLS)
# ================================================================================
MANAGER_DYN_PATH=1
DYN_SHADOW=0
DYN_ENFORCE=1
DYN_ALLOWED_SYMBOLS=
DYN_MIN_CONF=0.62
DYN_SAFE_STALE_SEC=35
BTC_GATE_ENABLE=1
DYN_DENYLIST=
CB_MAX_FAILS=5
CB_COOLDOWN_SEC=900
IDEMP_WINDOW_SEC=90
PROMETHEUS_ENABLE=1
