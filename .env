ALGOGPT_TOKENS=rnd_I7f7QQ6JXu55tuqfORcQKBdlxMPK
SECURITY_ALLOW_ALL=0

############################################
# 🧩 Versions / Metadata
############################################
ALGOGPT_VERSION=2.14.3
STRATEGY_VERSION=2.14.3
GIT_COMMIT=
REQ_HASH=

############################################
# ⚙️ Live Trading
############################################
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
ENABLE_AUTO_TRADING=true
AUTO_RUN=false          # השאר false אם WORKERS>1
WORKERS=2               # ל-AUTO_RUN=true → העבר ל-1

############################################
# 🔎 Scanner / Limits (Balanced)
############################################
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
TRENDING_ONLY=false
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=60

# יציבות תגובה:
RESPONSE_MAX_BYTES=1048576
SCAN_MAX_LIMIT=20
EXPOSE_LIMITS=true

############################################
# 💵 Risk / Budget
############################################
MAX_LEVERAGE=35
MAX_TRADE_BUDGET=100
MAX_TRADES_PER_TICK=3
PRICE_PROTECT_PCT=0.25
PRICE_MAX_AGE_SEC=10
SYMBOL_COOLDOWN_SEC=600

############################################
# 🟡 Binance
############################################
BINANCE_API_KEY=<SET_IN_RENDER>
BINANCE_API_SECRET=<SET_IN_RENDER>
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false
BINANCE_FORCE_HEDGE_MODE=false

# ✅ Allowlist ל־Binance (מה שנתת)
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

############################################
# 🤖 OpenAI
############################################
OPENAI_API_KEY=<SET_IN_RENDER>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4

############################################
# 📰 News / Macro (אופציונלי)
############################################
CRYPTO_PANIC_API_KEY=<optional>
NEWSAPI_API_KEY=<optional>
COINMARKETCAP_API_KEY=<optional>
COINDESK_API_KEY=<optional>

############################################
# 🌐 Misc / Server
############################################
CORS_ALLOW_ORIGINS=*
PORT=10000
