# --- Core / Security ---
ALGOGPT_VERSION=2.16.0
API_BEARER_TOKEN=PUT_STRONG_RANDOM_TOKEN
SECURITY_ALLOW_ALL=0
LOG_LEVEL=INFO
RESPONSE_MAX_BYTES=5242880
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0
ADMIN_CHAT_ID=449087907

# --- Server ---
PORT=10000
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0
WEB_CONCURRENCY=1
WORKERS=2

# --- Trading defaults ---
AUTO_RUN=true
EXECUTE_TRADES=true
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=8.5        # ← העלינו מ-7.5 ל-8.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
TRENDING_ONLY=false
TRENDING_SOURCE=coingecko
MAX_LEVERAGE=35
SYMBOL_COOLDOWN_SEC=600
SCAN_INTERVAL=60
SCAN_MAX_LIMIT=10
PRICE_MONITOR_DISABLE=0
PRICE_MONITOR_INTERVAL=60     # ← ניהול חי: בדיקת פוזיציות כל 60ש'
PRICE_MAX_AGE_SEC=10
PRICE_WS_FRESH_TTL=20

# --- Live management (חדש) ---
ALLOW_MANAGE_OPEN_TRADES=true # ← מאפשר ל-manage_open_trades להזיז SL/TP בפועל

# --- Watchlist (מומלץ להתאים) ---
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INDICATOR_INTERVALS=15m,1h
SYMS=BTCUSDT,ETHUSDT,SOLUSDT   # עבור price WS/REST monitor
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED
MIN_LEVERAGE=5

# --- Binance ---
BINANCE_API_KEY=PUT_BINANCE_API_KEY_64CH
BINANCE_API_SECRET=PUT_BINANCE_SECRET_64CH
BINANCE_TESTNET=false
BINANCE_RECV_WINDOW=45000
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7
SUPPRESS_BINANCE_WARNINGS=1
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
BINANCE_FORCE_HEDGE_MODE=false

# --- Health / Prices ---
LISTENKEY_KEEPALIVE_SEC=1800
HEALTH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HEALTH_PRICE_MAX_AGE=30
PRICE_SCAN_INTERVAL=15
WS_KEEPALIVE_SEC=25

# --- ExchangeInfo Fallbacks ---
DEFAULT_QTY_STEP=0.001
DEFAULT_PRICE_TICK=0.1
MIN_NOTIONAL_USDT=5

# --- OpenAI ---
OPENAI_API_KEY=PUT_ROTATED_OPENAI_KEY
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# --- Redis ---
REDIS_URL=redis://USER:PASS@HOST:6379

# --- Telegram ---
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=PUT_TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_CHAT_ID=  # אופציונלי; ADMIN_CHAT_ID כבר קיים

# --- Features Stage D (כבוי כברירת מחדל) ---
ENABLE_SMC=0
ENABLE_ICT=0
ENABLE_MARKET_STRUCTURE=0
SMC_INTERVALS=15m,1h
SMC_CACHE_TTL_SEC=120
SMC_MAX_SYMBOLS=20
SMC_RATE_LIMIT_PER_MIN=30

ENABLE_TRAILING_TP=0
TRAILING_TP_ARM_PCT=0.6
TRAILING_TP_STEP_PCT=0.15
TRAILING_TP_CHECK_SEC=10

ENABLE_MATRIX=0
MATRIX_INTERVALS=15m,1h
MATRIX_TOP_N=30
MATRIX_REFRESH_SEC=60
MATRIX_CACHE_TTL_SEC=60
MATRIX_RATE_LIMIT_PER_MIN=20

ENABLE_NOTION=0
NOTION_SYNC_SEC=300
NOTION_RATE_LIMIT_PER_MIN=10
ENABLE_EXCEL_EXPORT=0

ENABLE_SENTIMENT=0
SENTIMENT_SOURCES=cryptopanic,twitter
SENTIMENT_REFRESH_SEC=180
SENTIMENT_CACHE_TTL_SEC=120
SENTIMENT_RATE_LIMIT_PER_MIN=20
ENABLE_LEADERBOARD=0
LEADERBOARD_REFRESH_SEC=300
LEADERBOARD_CACHE_TTL_SEC=180

FEATURES_HARD_LIMIT_QPS=5
FEATURES_BURST=10
REDIS_NAMESPACING=algogpt:v2






























































































































































































