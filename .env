# ============================
# AlgoGPT — Production ENV
# ============================

# --- Security ---
API_BEARER_TOKEN=rnd_I7f7QQ6JXu55tuqfORcQKBdlxMPK
SECURITY_ALLOW_ALL=0

# --- Trading Settings ---
AUTO_RUN=true                   # ✅ סריקות אוטומטיות
EXECUTE_TRADES=true              # ✅ הפעלת מסחר חי
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
BINANCE_FORCE_HEDGE_MODE=false
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED

DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1

# --- Binance Keys (חובה לפרודקשן) ---
BINANCE_API_KEY=PASTE_YOUR_KEY_HERE
BINANCE_API_SECRET=PASTE_YOUR_SECRET_HERE
BINANCE_TESTNET=false

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# --- Redis (אופציונלי) ---
REDIS_URL=redis://default:password@localhost:6379

# --- Runtime ---
LIGHT_MODE=0
PRICE_MONITOR_DISABLE=0
LOG_LEVEL=INFO
PORT=10000
ALGOGPT_VERSION=2.15.0


















































































































































































