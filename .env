############################################
# Core / Security
############################################
ALGOGPT_VERSION=2.18.0
SECURITY_ALLOW_ALL=0
LOG_LEVEL=INFO
RESPONSE_MAX_BYTES=5242880
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0
PUBLIC_HOST=https://algogpt-docker.onrender.com

# Auth (להגדיר ב-Render)
API_BEARER_TOKEN=PUT_API_BEARER_TOKEN
ALGOGPT_TOKENS=PUT_INTERNAL_TOKENS_IF_USED

############################################
# Admin / Telegram (אישור טריידים)
############################################
ADMIN_CHAT_ID=449087907
TELEGRAM_ADMIN_IDS=449087907
TELEGRAM_ADMIN_ONLY=1
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=PUT_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_CHAT_ID=449087907
TELEGRAM_AUTO_WEBHOOK=1

############################################
# Server (Render)
############################################
APP_MODULE=main:app
PORT=10000
BIND_HOST=0.0.0.0
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0
UVICORN_ACCESS_LOG=false
WEB_CONCURRENCY=1
WORKERS=2
WEBHOOK_HOST=https://algogpt-docker.onrender.com
PYTHONPATH=/app

############################################
# DB / Redis
############################################
DATABASE_URL=sqlite:////app/data/algogpt.db
REDIS_URL=PUT_REDIS_URL
REDIS_NAMESPACING=algogpt:v2
USE_DB=1
USE_REDIS_IDEM=1

############################################
# OpenAPI (חשיפה מוגבלת)
############################################
OPENAPI_PUBLIC_MAX_OPS=30
OPENAPI_HIDE_PATTERNS=/telegram/*,/executor/bulk,/manage-once,/grid/dashboard/data

############################################
# Trading defaults (דינמי + אישור חובה)
############################################
AUTO_RUN=true
EXECUTE_TRADES=true
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
DEFAULT_VOL_REGIME=mid
MIN_QUALITY_SCORE=8
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
TRENDING_ONLY=false
TRENDING_SOURCE=coingecko
MAX_LEVERAGE=35
MIN_LEVERAGE=5
SYMBOL_COOLDOWN_SEC=600
SCAN_INTERVAL=90
SCAN_MAX_LIMIT=10
PRICE_MONITOR_DISABLE=0
PRICE_MONITOR_INTERVAL=60
PRICE_MAX_AGE_SEC=10
PRICE_WS_FRESH_TTL=20

############################################
# Scanner perf / throttling
############################################
SCAN_CONCURRENCY=4
SCAN_TIME_BUDGET_SEC=7.5

############################################
# Auto-Tune
############################################
AUTO_TUNE_ENABLE=1
AUTO_TUNE_MIN_SCAN_INTERVAL=60
AUTO_TUNE_MAX_SCAN_INTERVAL=180

############################################
# Watchlist / WS
############################################
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INDICATOR_INTERVALS=15m,1h
TOP10_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,TONUSDT,LTCUSDT

############################################
# Binance (HTTP/WS)
############################################
BINANCE_API_KEY=PUT_BINANCE_API_KEY
BINANCE_API_SECRET=PUT_BINANCE_API_SECRET
BINANCE_TESTNET=false
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=
BINANCE_WORKING_TYPE=MARK_PRICE
BINANCE_PRICE_PROTECT=false
BINANCE_RECV_WINDOW=45000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
TIME_SYNC_TIMEOUT_SEC=3.0
TIME_SYNC_SKEW_LIMIT_MS=2000
BINANCE_HTTP_TIMEOUT=10.0
BINANCE_MAX_RETRIES=6
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=200
HTTP_CONCURRENCY=32
ORDERS_QPS_BUCKET=8
ORDERS_BUCKET_WINDOW_SEC=10
ORDER_BACKOFF_BASE_MS=120
ORDER_BACKOFF_MAX_MS=1600
SUPPRESS_BINANCE_WARNINGS=1
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
BINANCE_FORCE_HEDGE_MODE=true
POSITION_MODE_OVERRIDE=hedge

############################################
# HTTP Circuit Breaker
############################################
CB_WINDOW_SEC=30
CB_FAIL_THRESHOLD=6
CB_OPEN_SEC=20

############################################
# Health / Prices
############################################
LISTENKEY_KEEPALIVE_SEC=1800
HEALTH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HEALTH_PRICE_MAX_AGE=30
PRICE_SCAN_INTERVAL=15
WS_KEEPALIVE_SEC=25

############################################
# ExchangeInfo Fallbacks
############################################
DEFAULT_QTY_STEP=0.001
DEFAULT_PRICE_TICK=0.01
MIN_NOTIONAL_USDT=5
EXCHANGE_INFO_TTL_SEC=900

############################################
# Positions cache / Rate limit
############################################
ACCOUNT_TTL_SEC=3
ACCOUNT_ON_BAN_BACKOFF_SEC=60

############################################
# ClientOrderId / Cancel policy
############################################
ORDER_ID_PREFIX=ALG_MAIN
ORDER_ID_SUFFIX=
ORDER_ID_INCLUDE_TS=1
ORDER_ID_MAXLEN=36
CANCEL_ONLY_PREFIXED_ORDERS=1
CANCEL_PREFIX_OVERRIDE=

############################################
# TP/SL Ladder defaults
############################################
LADDER_TP_ENABLE=1
LADDER_TP_KIND=TAKE_PROFIT_MARKET
LADDER_TP_DEFAULT_PCTS=1.8,3.2,5.5
LADDER_TP_DEFAULT_SPLITS=0.4,0.35,0.25
LADDER_TP_MAX_LEVELS=5
LADDER_SL_ENABLE=0
LADDER_SL_DEFAULT_PCTS=
LADDER_SL_MAX_LEVELS=3
TP_LADDER_COOLDOWN_SEC=60

############################################
# SOP / Gates
############################################
FEAT_BTC_GATE=1
FEAT_TF_ALIGN=1
FEAT_SPREAD_DEPTH=1
FEAT_MARK_INDEX_SANITY=1
FEAT_VOLUME_GATE=1
FEAT_PUMP_NUKE=1
FEAT_QUALITY_ENFORCE=1
FEAT_DAILY_CAPS=1
FEAT_COOLDOWN=1
FEAT_DEBOUNCE_LIMIT=1
SOP_MAX_SPREAD_BPS=3.0
SOP_MIN_TOP_QTY=0
SOP_MARK_INDEX_MAX_GAP_BPS=20.0
SOP_PUMP_NUKE_MAX_5M_PCT=1.0
SOP_VOLUME_MIN_RATIO=1.2

############################################
# Approvals / Preflight (אישור חובה!)
############################################
APPROVAL_ENABLED=1
APPROVAL_EARLY_AI=1
PROPOSE_BLOCK_ON_FAIL=0
SINK_ENFORCE_APPROVALS=1
APPROVAL_REQUIRE_WATCHLIST=0
APPROVAL_SUCCESS_MIN=60
APPROVAL_RR_MIN=1.30
MIN_TP_SL_DIFF_PCT=0.15
APPROVAL_MAX_SL_PCT=3.0
APPROVAL_DUP_COOLDOWN_SEC=300
AUTO_OPEN_ON_APPROVE=1

############################################
# OpenAI
############################################
ENABLE_AI_ROUTES=true
OPENAI_API_KEY=PUT_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE=https://api.openai.com

AI_ANALYZE_RPM=5
AI_MIN_QUALITY=8
AI_CONFLICT_MIN=0.2
AI_HTTP_RETRIES=3
AI_HTTP_BACKOFF_BASE=0.6
AI_HTTP_BACKOFF_MAX=4.0

############################################
# AI Review
############################################
AI_REVIEW_ENABLE=1
AI_REVIEW_RATE_PER_MIN=12
AI_REVIEW_MAX_TOKENS=400
AI_REVIEW_IDEMP_TTL_SEC=900

############################################
# Alerts / Sink endpoints
############################################
ALERTS_ACTIVE_URL=https://algogpt-docker.onrender.com/alerts/trades/active
ALERTS_UPDATE_URL=https://algogpt-docker.onrender.com/alerts/trades/update
ALERTS_ANALYSIS_URL=https://algogpt-docker.onrender.com/alerts/analysis
ALERTS_INGEST_URL=https://algogpt-docker.onrender.com/alerts/trade-ingest
RISK_QUICK_URL=https://algogpt-docker.onrender.com/risk/quick
WEBHOOK_HMAC_SECRET=PUT_STRONG_RANDOM_64

############################################
# GPT Auto-Suggest (אוטו → שולח לאישור)
############################################
TRADE_AUTO_SUGGEST=1
SYMBOLS_PER_CYCLE=10
SUGGEST_CAP_PER_CYCLE=5
SUGGEST_FUTURES=1
SUGGEST_SPOT=0
SUGGEST_GRID=0
SUGGEST_INTERVAL_SEC=600
SUCCESS_PCT_MIN=70
MIN_RR_TOP10=1.6
MIN_RR_ALT=1.9
CONTEXT_URL=https://algogpt-docker.onrender.com

############################################
# User-Data Stream
############################################
USER_STREAM_ENABLE=1
USER_STREAM_RECONNECT_BACKOFF=3.0
USER_STREAM_RECONNECT_MAX_BACKOFF=60.0
WS_LOG_SAMPLE_N=20
STREAM_TP_BE=true
STREAM_WS_KEEPALIVE_SEC=25

############################################
# Grid TP (אם משתמשים)
############################################
GRID_ENABLE=true
GRID_TP1_ATR=1.0
GRID_TP2_ATR=1.8
GRID_TP3_ATR=2.6
GRID_SPLIT_1=0.33
GRID_SPLIT_2=0.33
GRID_SPLIT_3=0.34
GRID_STATE_CLEANUP_TTL_SEC=86400

############################################
# Manager / Chop detection
############################################
CHOP_DETECT_ENABLE=true
CHOP_ADX_MAX=18
CHOP_MACD_HIST_ABS_MAX=0.05
CHOP_BB_WIDTH_PCT_MAX=0.9
CHOP_MIN_BARS=6
CHOP_TIME_LIMIT_MIN=45
CHOP_ACTION=to_breakeven
CHOP_PARTIAL_PCT=0.33
BE_ARM_PCT=1.6
TRAIL_ATR_MULT=1.5
MOMENTUM_LOCK_MIN_BARS=3
MANAGER_COOLDOWN_SEC=45

############################################
# Trade Executor – Guards (דינמי + אישור)
############################################
ALLOW_MARKET_ENTRY=1
ENTRY_BAND_BPS=8
STOP_BAND_BPS=10
ESCALATE_AFTER_SEC=10
ESCALATE_SLIPPAGE_BPS=15
PERCENT_PRICE_GUARD_BPS=45
SLIPPAGE_GUARD_BPS=35
POST_FILL_SANITY_BPS=40
SL_LIMIT_OFFSET_BPS=8
TP_LIMIT_OFFSET_BPS=8
IDEMPOTENCY_TTL_SEC=15
CONFIRM_TTL_SEC=180
CANCEL_MIN_AGE_SEC=0
CANCEL_MAX_AGE_SEC=0
CANCEL_TTL_SEC=0
AUTO_CANCEL_TTL_MIN=60
AUTO_CANCEL_TTL_MAX=900

############################################
# Dynamic HYBRID policy (ATR)
############################################
DYNAMIC_POLICY_ENABLE=1
DYN_ATR_LOW_PCT=0.5
DYN_ATR_HIGH_PCT=3.5
DYN_ENTRY_MIN_BPS=5
DYN_ENTRY_MAX_BPS=20
DYN_STOP_MIN_BPS=6
DYN_STOP_MAX_BPS=25
DYN_ESCALATE_AFTER_MIN=5
DYN_ESCALATE_AFTER_MAX=25
DYN_ESCALATE_SLIP_MIN_BPS=5
DYN_ESCALATE_SLIP_MAX_BPS=60
DYN_SLIP_GUARD_MIN_BPS=20
DYN_SLIP_GUARD_MAX_BPS=80
DYN_CANCEL_MIN_SEC=5
DYN_CANCEL_BASE_SEC=15
DYN_CANCEL_MAX_SEC=60

############################################
# Binance percent-guard (client)
############################################
PERCENT_GUARD_ENABLE=1
PERCENT_GUARD_BPS=50
IDEMP_TTL_SEC=900
PRICE_CACHE_TTL_MS=250

############################################
# Liquidity gate (ללא I/O, מהיר)
############################################
LIQ_MAX_NOTIONAL_TOP10=200000
LIQ_MAX_NOTIONAL_OTHERS=50000
LIQ_USE_SLIPPAGE=0
SLIPPAGE_MAX_PCT_TOP10=0.40
SLIPPAGE_MAX_PCT_OTHERS=0.80

############################################
# Risk rules (RR / מרחק כניסה)
############################################
ENTRY_GAP_MAX_PCT=0.80
ENTRY_GAP_WARN_PCT=0.50
RR_MIN_LOW_VOL=1.5
RR_MIN_MID_VOL=1.6
RR_MIN_HIGH_VOL=1.8
LEV_HARD_CAP=50
SUCCESS_WARN_PCT=60





























































































































































































































