# ================================================================================
# AlgoGPT Trading Platform - Environment Configuration Example
# ================================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your actual .env file with real secrets to Git!
# ================================================================================

# ================================================================================
# CORE / SECURITY
# ================================================================================
# Application version
ALGOGPT_VERSION=2.18.0

# Security - set to 0 for production
SECURITY_ALLOW_ALL=0

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum response size in bytes
RESPONSE_MAX_BYTES=5242880

# CORS settings
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=0

# ================================================================================
# AUTHENTICATION & AUTHORIZATION
# ================================================================================
# API Bearer token for protected routes - CHANGE IN PRODUCTION!
API_BEARER_TOKEN=PUT_STRONG_RANDOM_TOKEN

# AlgoGPT API tokens (comma-separated if multiple)
ALGOGPT_TOKENS=PUT_STRONG_RANDOM_TOKEN

# Primary API token for X-API-Key header authentication
PRIMARY_API_TOKEN=PUT_STRONG_RANDOM_TOKEN

# Additional API token
API_TOKEN=PUT_STRONG_RANDOM_TOKEN

# Route protection - set to 1 to protect approval routes
PROTECT_APPROVE_ROUTES=0

# OPS signing secret for HMAC signatures
OPS_SIGN_SECRET=PUT_LONG_RANDOM_SECRET

# Webhook HMAC secret for signature verification
WEBHOOK_HMAC_SECRET=PUT_LONG_RANDOM_SECRET

# ================================================================================
# ADMIN & PERMISSIONS
# ================================================================================
# Admin Telegram chat ID (get from @userinfobot on Telegram)
ADMIN_CHAT_ID=0

# Comma-separated list of admin Telegram user IDs
TELEGRAM_ADMIN_IDS=0

# Restrict operations to admins only (1=yes, 0=no)
TELEGRAM_ADMIN_ONLY=0

# Pause auto-run mode (1=paused, 0=running)
PAUSE_AUTO_RUN=0

# ================================================================================
# SERVER CONFIGURATION
# ================================================================================
# Server port - MUST be 5000 for Replit webview
PORT=5000

# Bind address - use 0.0.0.0 to allow external connections
BIND_HOST=0.0.0.0

# Uvicorn settings
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=0

# Number of Gunicorn workers
WEB_CONCURRENCY=1
WORKERS=1

# Public host URL for webhooks (e.g., https://yourapp.replit.app)
PUBLIC_HOST=

# HTTP/2 support
HTTP2_ENABLED=0

# ================================================================================
# DATABASE - POSTGRESQL
# ================================================================================
# Enable database persistence (1=enabled, 0=disabled)
USE_DB=1

# PostgreSQL connection URL - Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/algogpt

# Database connection details (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=algogpt_user
PGPASSWORD=PUT_DB_PASSWORD
PGDATABASE=algogpt

# ================================================================================
# REDIS - OPTIONAL CACHE & QUEUE
# ================================================================================
# Redis connection URL (optional) - Format: redis://user:password@host:port
REDIS_URL=

# Redis namespace prefix
REDIS_NAMESPACING=algogpt:v2

# Namespace for keys
NS=algogpt

# Require Redis to run (1=required, 0=optional)
REQUIRE_REDIS=0

# Confirm store enable
CONFIRMSTORE_ENABLE=1

# Idempotency key TTL (seconds)
IDEM_TTL_SEC=600

# OPS ticket TTL (seconds)
OPS_TICKET_TTL_SEC=3600

# ================================================================================
# TRADING DEFAULTS & EXECUTION
# ================================================================================
# CRITICAL: Enable/disable automated trading
AUTO_RUN=false
EXECUTE_TRADES=false

# Allow managing open trades automatically
ALLOW_MANAGE_OPEN_TRADES=false

# Default trading settings
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
DEFAULT_VOL_REGIME=mid

# Quality filters
MIN_QUALITY_SCORE=8.5
QUALITY_MIN_SCORE=8.5

# Trading limits
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=1
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000

# Leverage limits
MAX_LEVERAGE=35
MIN_LEVERAGE=5
AUTO_LEV_MIN=5
AUTO_LEV_MAX=35

# Auto budget limits
AUTO_BUDGET_MIN=30
AUTO_BUDGET_MAX=100

# Timing controls
SYMBOL_COOLDOWN_SEC=600
SCAN_INTERVAL=90
SCAN_MAX_LIMIT=10

# ================================================================================
# SCANNER PERFORMANCE & THROTTLING
# ================================================================================
SCAN_CONCURRENCY=4
SCAN_TIME_BUDGET_SEC=7.5

# ================================================================================
# WATCHLIST & SYMBOLS
# ================================================================================
# Comma-separated list of symbols
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
INDICATOR_INTERVALS=15m,1h
SYMS=BTCUSDT,ETHUSDT,SOLUSDT

# ================================================================================
# BINANCE API CONFIGURATION
# ================================================================================
# Binance API credentials - REQUIRED FOR TRADING
BINANCE_API_KEY=PUT_BINANCE_API_KEY_64CH
BINANCE_API_SECRET=PUT_BINANCE_SECRET_64CH

# Testnet mode
BINANCE_TESTNET=false

# API endpoints
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
BINANCE_WS_STREAM_SUFFIX=/stream?streams=

# Legacy endpoint vars (for compatibility)
BIN_FUT_HTTP=https://fapi.binance.com
BIN_SPOT_HTTP=https://api.binance.com

# Trading settings
BINANCE_MARGIN_TYPE_DEFAULT=ISOLATED
BINANCE_WORKING_TYPE=MARK_PRICE
ORDER_TRIGGER=mark
POSITION_MODE_OVERRIDE=
BINANCE_PRICE_PROTECT=false
BINANCE_SKIP_ACCOUNT_MUTATIONS=false
BINANCE_FORCE_HEDGE_MODE=false
SUPPRESS_BINANCE_WARNINGS=1
ORDER_ID_PREFIX=ALG

# API request settings
BINANCE_RECV_WINDOW=45000
BINANCE_HTTP_TIMEOUT=8.0
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7

# Connection pool settings
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=100
HTTP_CONCURRENCY=32

# Time synchronization
BINANCE_TIME_SYNC_INTERVAL_SEC=900
TIME_SYNC_TIMEOUT_SEC=3.0
TIME_SYNC_SKEW_LIMIT_MS=2000

# Rate limiting
ORDERS_QPS_BUCKET=8
ORDERS_BUCKET_WINDOW_SEC=10
ORDER_BACKOFF_BASE_MS=80
ORDER_BACKOFF_MAX_MS=1200

# Allowed egress IPs (Binance whitelist)
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

# ================================================================================
# HTTP CIRCUIT BREAKER
# ================================================================================
CB_WINDOW_SEC=30
CB_FAIL_THRESHOLD=6
CB_OPEN_SEC=20

# ================================================================================
# HEALTH / PRICES
# ================================================================================
LISTENKEY_KEEPALIVE_SEC=1800
HEALTH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HEALTH_PRICE_MAX_AGE=30
PRICE_SCAN_INTERVAL=15
WS_KEEPALIVE_SEC=25
PRICE_MAX_AGE_SEC=10
PRICE_MONITOR_DISABLE=0
PRICE_MONITOR_INTERVAL=60
PRICE_WS_FRESH_TTL=20

# ================================================================================
# EXCHANGE INFO FALLBACKS
# ================================================================================
DEFAULT_QTY_STEP=0.001
DEFAULT_PRICE_TICK=0.1
MIN_NOTIONAL_USDT=5
EXCHANGE_INFO_TTL_SEC=900

# ================================================================================
# AI PROVIDERS - OPENAI
# ================================================================================
# Enable AI-powered routes
ENABLE_AI_ROUTES=false

# OpenAI API key - REQUIRED FOR AI FEATURES
OPENAI_API_KEY=PUT_OPENAI_KEY

# OpenAI models
OPENAI_MODEL=gpt-4o
GPT5_MODEL=gpt-5-2025-08-07

# OpenAI API settings
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=30.0

# ================================================================================
# AI PROVIDERS - DEEPSEEK
# ================================================================================
# DeepSeek API key for multi-AI consensus
DEEPSEEK_API_KEY=

# DeepSeek settings
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# ================================================================================
# AI PROVIDERS - X.AI / GROK
# ================================================================================
# X.AI API key (for Grok model)
XAI_API_KEY=

# X.AI settings
XAI_MODEL=grok-beta
XAI_API_BASE=https://api.x.ai/v1
XAI_BASE_URL=https://api.x.ai/v1

# ================================================================================
# MULTI-AI CONSENSUS SYSTEM
# ================================================================================
# Enable Multi-AI Consensus Scoring (combines GPT-5, DeepSeek, Grok)
ENABLE_MULTI_AI_CONSENSUS=1

# Minimum number of AI providers required for consensus (2-3)
CONSENSUS_MIN_PROVIDERS=2

# Enable individual AI providers for consensus
ENABLE_OPENAI=1
ENABLE_DEEPSEEK=1
ENABLE_XAI=1

# AI Provider budgets tracking (in USD) - can be negative for credit
OPENAI_BUDGET=40.0
DEEPSEEK_BUDGET=10.0
XAI_BUDGET=-15.0

# ================================================================================
# AI WORKERS - DeepSeek Optimizer
# ================================================================================
# Enable DeepSeek trade parameter optimizer worker
DEEPSEEK_OPTIMIZER_ENABLED=1
DEEPSEEK_OPTIMIZER_INTERVAL=3600
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ================================================================================
# AI WORKERS - AI-X (Grok) Supervisor
# ================================================================================
# Enable AI-X system supervisor and anomaly detection worker
AIX_SUPERVISOR_ENABLED=1
AIX_SUPERVISOR_INTERVAL=1800

# ================================================================================
# AI WORKERS - News Sentiment Analyzer
# ================================================================================
# Enable news sentiment analysis worker
NEWS_SENTIMENT_ENABLED=1
NEWS_SENTIMENT_INTERVAL=3600

# News API settings (optional - uses mock data by default)
NEWS_API_URL=https://cryptopanic.com/api/v1/posts/
NEWS_API_KEY=

# ================================================================================
# AI PROVIDERS - ADDITIONAL
# ================================================================================
COHERE_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=

# ================================================================================
# TELEGRAM CONFIGURATION
# ================================================================================
# Telegram Bot token - REQUIRED FOR NOTIFICATIONS
TELEGRAM_BOT_TOKEN=PUT_TELEGRAM_BOT_TOKEN

# Telegram chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=0

# Telegram webhook settings
TELEGRAM_WEBHOOK_SECRET=PUT_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_AUTO_WEBHOOK=0

# Telegram notification settings
TELEGRAM_SEND_ENABLE=1
TG_NOTIFY_RECONCILE=1
TG_NOTIFY_GRID=1
TG_NOTIFY_MANAGER=0

# Public feed broadcasting
PUBLIC_FEED_CHANNEL_ID=
ENABLE_PUBLIC_FEED=0

# ================================================================================
# N8N WORKFLOW AUTOMATION
# ================================================================================
# N8N webhook secret - REQUIRED FOR PRODUCTION
N8N_WEBHOOK_SECRET=PUT_N8N_WEBHOOK_SECRET

# N8N webhook URLs
N8N_WEBHOOK_URL=
N8N_INCIDENT_WEBHOOK=

# ================================================================================
# VALIDATION & SAFETY INFRASTRUCTURE (v2.0)
# ================================================================================
# Require backtest validation before live trading
VALIDATION_REQUIRED=1

# Enable dual confirmation (Quant ∧ AI ∧ Risk)
DUAL_CONFIRM_ENABLE=1

# Monte Carlo distribution (student_t, bootstrap, garch)
MC_DIST_SOURCE=student_t

# Backtest thresholds
MIN_WINRATE_PCT=46
MIN_RR=1.45
MAX_DRAWDOWN_PCT=12

# ================================================================================
# CIRCUIT BREAKER & RISK LIMITS
# ================================================================================
# Daily drawdown limit percentage
BREAKER_DD_LIMIT_PCT=5.0

# Max consecutive stop losses before circuit breaker
BREAKER_CONSEC_SL_MAX=4

# Volatility spike threshold percentage
BREAKER_VOLATILITY_THRESHOLD=50

# Daily hard loss limit in USD (negative value)
DAILY_HARD_LOSS_USD=-150

# Health killswitch threshold
KILLSWITCH_THRESHOLD=3

# ================================================================================
# FEATURE FLAGS
# ================================================================================
FEAT_BTC_GATE=1
FEAT_TF_ALIGN=1
FEAT_SPREAD_DEPTH=1
FEAT_MARK_INDEX_SANITY=1
FEAT_VOLUME_GATE=1
FEAT_PUMP_NUKE=1
FEAT_QUALITY_ENFORCE=1
FEAT_DAILY_CAPS=1
FEAT_COOLDOWN=1
FEAT_DEBOUNCE_LIMIT=1

# SOP parameters
SOP_MAX_SPREAD_BPS=3.0
SOP_MIN_TOP_QTY=0
SOP_MARK_INDEX_MAX_GAP_BPS=20.0
SOP_PUMP_NUKE_MAX_5M_PCT=1.0
SOP_VOLUME_MIN_RATIO=1.2

# ================================================================================
# APPROVAL WORKFLOW
# ================================================================================
APPROVAL_ENABLED=1
APPROVAL_EARLY_AI=0
SINK_ENFORCE_APPROVALS=1
APPROVAL_REQUIRE_WATCHLIST=1
APPROVAL_SUCCESS_MIN=60
APPROVAL_RR_MIN=1.30
MIN_TP_SL_DIFF_PCT=0.15
APPROVAL_MAX_SL_PCT=3.0
APPROVAL_DUP_COOLDOWN_SEC=300
PROPOSE_BLOCK_ON_FAIL=0

# Telegram approval settings
REQUIRE_TELEGRAM_APPROVAL=1
AUTO_OPEN_ON_APPROVE=1
SMART_MANAGE_ON_APPROVE=1

# ================================================================================
# TRADE MANAGEMENT & EXECUTION
# ================================================================================
TRADE_MANAGER_ENABLE=1
MANAGER_ENABLE=1
TRAIL_ENABLE=1
BE_GUARD_ENABLE=1

# ================================================================================
# TRADE PROPOSAL & AUTO-SUGGEST
# ================================================================================
TRADE_AUTO_SUGGEST=1
SUGGEST_FUTURES=1
SUGGEST_GRID=1
SUGGEST_INTERVAL_SEC=60

# URLs for auto-suggest
CONTEXT_URL=http://127.0.0.1:5000
ALERT_INGEST_URL=http://127.0.0.1:5000/alerts/ingest

# ================================================================================
# ALERTS / SINK ENDPOINTS
# ================================================================================
ALERTS_ACTIVE_URL=http://127.0.0.1:5000/alerts/trades/active
ALERTS_UPDATE_URL=http://127.0.0.1:5000/alerts/trades/update
ALERTS_ANALYSIS_URL=http://127.0.0.1:5000/alerts/analysis
ALERTS_INGEST_URL=http://127.0.0.1:5000/alerts/trade-ingest
RISK_QUICK_URL=http://127.0.0.1:5000/risk/quick

# ================================================================================
# AI SUGGEST QUEUE / SCHEDULER
# ================================================================================
AI_QUEUE_TO_TELEGRAM=1
AI_QUEUE_AUTO_EXECUTE=0
AI_SCHED_ENABLE=0
AI_SCHED_INTERVAL_SEC=300

# ================================================================================
# USER-DATA STREAM
# ================================================================================
STREAM_WS_KEEPALIVE_SEC=25
ORDER_EVENT_RATE_LIMIT=15
STREAM_TP_BE=true
TP_LOCK_STAGE2_ATR=0.5
BE_ARM_PCT=1.6
TRAIL_ATR_MULT=1.5
MOMENTUM_LOCK_MIN_BARS=3
MANAGER_COOLDOWN_SEC=45

# ================================================================================
# GRID TP
# ================================================================================
GRID_ENABLE=true
GRID_TP1_ATR=1.0
GRID_TP2_ATR=1.8
GRID_TP3_ATR=2.6
GRID_SPLIT_1=0.33
GRID_SPLIT_2=0.33
GRID_SPLIT_3=0.34
GRID_STATE_CLEANUP_TTL_SEC=86400

# ================================================================================
# CHOP DETECTION
# ================================================================================
CHOP_DETECT_ENABLE=true
CHOP_ADX_MAX=18
CHOP_MACD_HIST_ABS_MAX=0.05
CHOP_BB_WIDTH_PCT_MAX=0.9
CHOP_MIN_BARS=6
CHOP_TIME_LIMIT_MIN=45
CHOP_ACTION=to_breakeven
CHOP_PARTIAL_PCT=0.33

# ================================================================================
# LEGACY WORKERS (PHASE 3)
# ================================================================================
# Enable legacy Phase 3 AI workers
ENABLE_LEGACY_WORKERS=0

# ================================================================================
# UI & DASHBOARD
# ================================================================================
UI_POLL_MS=2500
UI_IDLE_STOP_SEC=900

# ================================================================================
# ETA & TIME TRACKING
# ================================================================================
ETA_SMART_ENABLE=1
ETA_VELOCITY_WINDOW=22.0

# ================================================================================
# DEBUGGING & DEVELOPMENT
# ================================================================================
DEBUG_SIGN=1
ROUTES_AUTOLOAD=0
ROUTES_AUTOLOAD_MODE=eager
REQUIRE_SIGNATURE=0

# ================================================================================
# GITHUB AUTO-COMMIT
# ================================================================================
GITHUB_AUTO_COMMIT_ENABLED=1
GITHUB_AUTO_COMMIT_INTERVAL=3600
GITHUB_REPO_PATH=/home/runner/workspace
GITHUB_COMMIT_AUTHOR=AlgoGPT System
GITHUB_COMMIT_EMAIL=algogpt@system.local
GITHUB_COMMIT_TELEGRAM_NOTIFY=1

# ================================================================================
# MONITORING & HEALTH CHECKS
# ================================================================================
ENABLE_POSITION_MONITOR=1
POSITION_REPORT_INTERVAL_SEC=1800
POSITION_ALERT_LEVEL=critical
BASE_URL=http://127.0.0.1:5000
HEARTBEAT_INTERVAL=600
HEARTBEAT_ALERT_LEVEL=critical
SENTINEL_ENABLED=1
SENTINEL_ALERT_LEVEL=critical

# ================================================================================
# DOCUMENTATION
# ================================================================================
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
APP_TITLE=AlgoGPT Service
APP_VERSION=3.6.0

# ================================================================================
# END OF CONFIGURATION
# ================================================================================




















