# =========================
# 🔐 Auth / Security
# =========================
API_BEARER_TOKEN=rnd_xxxxx                 # טוקן API פנימי
ALGOGPT_TOKENS=rnd_xxxxx                   # טוקנים נוספים (אם יש)
SECURITY_ALLOW_ALL=0                       # 1=מאפשר הכל (לא מומלץ)

# =========================
# ⚙️ Live Trading
# =========================
EXECUTE_TRADES=true
BINANCE_SKIP_ACCOUNT_MUTATIONS=false       # אל תשנה סוג חשבון אוטומטית
AUTO_RUN=true                              # הפעלת אוטו־סקאן ברירת מחדל

# =========================
# 🔎 Scanner / Limits
# =========================
DEFAULT_INTERVAL=15m
DEFAULT_MARKET=futures
MIN_QUALITY_SCORE=7.5
TOP_SYMBOLS=30
MAX_TRADES_PER_TICK=3

# =========================
# 💵 Risk / Budget
# =========================
MAX_LEVERAGE=35
MAX_TRADE_BUDGET=100

# =========================
# 🟡 Binance
# =========================
BINANCE_API_KEY=<PUT_REAL_BINANCE_KEY>
BINANCE_API_SECRET=<PUT_REAL_BINANCE_SECRET>
BINANCE_TESTNET=false
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_RECV_WINDOW=20000

# =========================
# 🤖 OpenAI
# =========================
OPENAI_API_KEY=<PUT_REAL_OPENAI_KEY>
OPENAI_MODEL=gpt-4o
ENABLE_AI_ROUTES=true

# =========================
# 🔄 WS / Price updater
# =========================
WS_UPDATE_INTERVAL=15
PRICE_MONITOR_DISABLE=false
PRICE_WS_FRESH_TTL=20
PRICE_MONITOR_INTERVAL=30

# =========================
# 📊 BTC Anchor (Market context)
# =========================
BTC_ANCHOR_MODE=soft
BTC_ANCHOR_FRAMES=15m,1h,4h,1d
BTC_ANCHOR_STRONG_TH=70
BTC_ANCHOR_WEAK_TH=55

# =========================
# 📝 Logs
# =========================
LOG_BUFFER_SIZE=500
LOG_LEVEL=INFO

# =========================
# 🌐 Server
# =========================
PORT=10000

# =========================
# 🗄️ Redis (Optional)
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# 🚦 Mode control
# =========================
# 0 = Full Mode (Binance + Redis)
# 1 = Light Mode (No Binance/Redis, טוב ל־Render/debug)
LIGHT_MODE=0



















