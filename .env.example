# ===== Runtime =====
AUTO_RUN=true
PORT=5000
LOG_LEVEL=INFO

# ===== Binance (SET IN RENDER UI — DO NOT COMMIT) =====
BINANCE_API_KEY=__SET_IN_RENDER__
BINANCE_API_SECRET=__SET_IN_RENDER__

# Endpoints (ברירת מחדל תקינה)
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=

# יציבות / Anti-403 / Time Sync
BINANCE_MAX_RETRIES=5
BINANCE_BACKOFF_BASE=0.7
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false

# Allowlist (ה-egress של Render שהגדרת בבינאנס)
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

# Position Mode
# ברירת מחדל: זיהוי אוטומטי (אל תגדיר). כדי לכפות:
# BINANCE_FORCE_HEDGE_MODE=true   # תמיד Hedge Mode
# BINANCE_FORCE_HEDGE_MODE=false  # תמיד One-Way

# ===== Scanner/Algo =====
DEFAULT_INTERVAL=15m
SCAN_INTERVAL=60
MIN_QUALITY_SCORE=6
MAX_TRADE_BUDGET=100
MIN_VOLUME=1000000
TOP_SYMBOLS=30
PRICE_MAX_AGE_SEC=10
PRICE_PROTECT_PCT=0.25
MAX_LEVERAGE=35

# ===== OpenAI (SET IN RENDER UI — DO NOT COMMIT) =====
OPENAI_API_KEY=__SET_IN_RENDER__

# ===== Python runtime (אופציונלי) =====
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1











