# --- Security ---
API_BEARER_TOKEN=GrwpXpkRWunC7SPZGFrhaizBwcaZzpWLYJ9kv4W7u6aTx_EXu0VGfpBKaBhThLD2

# --- Automation ---
AUTO_RUN=false
ENABLE_AUTO_TRADING=false
EXECUTE_TRADES=false
BINANCE_SKIP_ACCOUNT_MUTATIONS=true

# --- Scan / Strategy defaults ---
SCAN_INTERVAL=60
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6
MIN_VOLUME=1000000
TOP_SYMBOLS=30
TRENDING_ONLY=false
SCAN_REF_TF=15m
TP_TIER_MULTS=0.8,1.6,2.5

# --- Protections ---
PRICE_PROTECT_PCT=0.25
PRICE_MAX_AGE_SEC=10

# --- Risk limits ---
MAX_TRADE_BUDGET=100
MAX_LEVERAGE=35

# --- Logs / CORS ---
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# --- Binance ---
BINANCE_API_KEY=__PUT_YOUR_KEY__
BINANCE_API_SECRET=__PUT_YOUR_SECRET__
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false
BINANCE_FORCE_HEDGE_MODE=false
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=

# --- OpenAI ---
OPENAI_API_KEY=__PUT_YOUR_OPENAI_KEY__
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4
OPENAI_BASE_URL=

# --- Egress ---
EGRESS_IP_ENDPOINT=
BINANCE_ALLOWED_EGRESS_IPS=

# --- Render / Port ---
PORT=10000

# --- Strategy meta ---
STRATEGY_NAME=AlgoGPT-Pro
STRATEGY_VERSION=1.0.0
GIT_COMMIT=unknown
REQ_HASH=unknown













