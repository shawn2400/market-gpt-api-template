# 🔐 Auth
ALGOGPT_TOKEN=changeme-please-use-strong-token
SECURITY_ALLOW_ALL=0

# ⚙️ Flags
AUTO_RUN=false
ENABLE_AUTO_TRADING=false
EXECUTE_TRADES=false
BINANCE_SKIP_ACCOUNT_MUTATIONS=true

# 🔎 Scanner
SCAN_INTERVAL=60
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6
TOP_SYMBOLS=30
TRENDING_ONLY=false
TOP_VOLUME_MIN_QV=1000000

# 💵 Risk
MAX_TRADE_BUDGET=100
MAX_LEVERAGE=35

# Logging / CORS
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Binance (set in Render Secrets)
BINANCE_API_KEY=<TO_BE_SET_IN_RENDER>
BINANCE_API_SECRET=<TO_BE_SET_IN_RENDER>
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com

# OpenAI
OPENAI_API_KEY=<TO_BE_SET_IN_RENDER>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4

# Server
PORT=10000
















