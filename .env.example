# ========================
# Binance API Credentials
# ========================
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ========================
# OpenAI API Key
# ========================
OPENAI_API_KEY=your_openai_api_key_here

# ========================
# Auto Executor Settings
# ========================
# האם להפעיל אוטומטית את הלולאה (true/false)
AUTO_RUN=true

# סף איכות מינימלי לסימבולים עבור טריידים אוטומטיים (0-10)
MIN_QUALITY_SCORE=6

# תקציב מקסימלי לכל טרייד ב-USD
MAX_TRADE_BUDGET=100

# זמן המתנה בין סריקות בלולאת האוטו (בשניות)
SCAN_INTERVAL=10

# ========================
# פילטר נפח ומגמה (אופציונלי)
# ========================
# נפח מינימלי למסחר (מסונן לסימבולים)
MIN_VOLUME=1000000

# האם לסרוק רק מטבעות בטרנד (true/false)
TRENDING_ONLY=true

# ========================
# הגבלות WebSocket (ליציבות)
# ========================
# מספר מקסימלי של סימבולים בו זמנית ב-WS (עדיף 10-20)
MAX_WS_SYMBOLS=15










