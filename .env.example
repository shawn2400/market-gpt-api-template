############################################
# 🔐 Auth  (דרוש ל-endpoints מוגנים כמו /grid/status, /decision/*)
############################################
# הגדר לפחות אחד מהבאים (הראשון עדיף). כולם נתמכים בקוד:
ALGOGPT_TOKEN=changeme-please-use-32-64-strong-token
# חלופות נתמכות:
# ALGOGPT_API_TOKEN=
# API_BEARER=

# מצב פיתוח בלבד: לאכוף גישה פתוחה (לא מומלץ בפרודקשן)
SECURITY_ALLOW_ALL=0   # 1 כדי לבטל אימות (פיתוח), אחרת 0

############################################
# ⚙️ App Flags
############################################
AUTO_RUN=true
ENABLE_AUTO_TRADING=false
EXECUTE_TRADES=false                  # הפוך ל-true רק בסביבת PROD ובזהירות!
BINANCE_SKIP_ACCOUNT_MUTATIONS=true   # false נדרש לפני LIVE /trade/live

############################################
# 🔎 Scanner / Defaults
############################################
SCAN_INTERVAL=60
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6

# כמות סימבולים לסריקת Top-Volume
TOP_SYMBOLS=30
# האם להחזיר רק סימבולים בטרנד פעיל (ADX וכו')
TRENDING_ONLY=false

# סף מינימלי ל-quoteVolume ב-Top-Volume (דולרים, 24h)
# משמש ע"י utils/top_volume.py (ENV_MIN_QV=TOP_VOLUME_MIN_QV)
TOP_VOLUME_MIN_QV=1000000

############################################
# 💵 Price protection
############################################
PRICE_PROTECT_PCT=0.25
PRICE_MAX_AGE_SEC=10

############################################
# 📈 Risk limits
############################################
MAX_TRADE_BUDGET=100
MAX_LEVERAGE=35

############################################
# 🧮 Decision Engine Weights (utils/scoring.py)
############################################
DECISION_W_QUALITY=0.40
DECISION_W_SUCCESS=0.25
DECISION_W_SPEED=0.15
DECISION_W_VOLAT=0.10
DECISION_W_DECORR=0.10

############################################
# 🗒️ Logging / CORS
############################################
LOG_LEVEL=INFO
# כשהאפליקציה חשופה לאינטרנט, מומלץ להגביל מקורות:
# דוגמה: CORS_ALLOW_ORIGINS=https://your-frontend.app
CORS_ALLOW_ORIGINS=*

############################################
# 🟡 Binance (מפתחות מוגדרים בסודיות ב-PaaS)
############################################
BINANCE_API_KEY=<TO_BE_SET_IN_RENDER>
BINANCE_API_SECRET=<TO_BE_SET_IN_RENDER>
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900
BINANCE_EXCHANGE_INFO_ON_START=false
BINANCE_FORCE_HEDGE_MODE=false

# Endpoints רשמיים:
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com
BINANCE_WS_STREAM_SUFFIX=/stream?streams=

############################################
# 🤖 OpenAI
############################################
OPENAI_API_KEY=<TO_BE_SET_IN_RENDER>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4
# אם אתה לא עובד מול פרוקסי/שרת חלופי, השאר ברירת מחדל:
OPENAI_BASE_URL=https://api.openai.com/v1

############################################
# 📰 News (אופציונלי – יאפשר /news/crypto אמיתי)
############################################
# CRYPTOPANIC_TOKEN=<optional>

############################################
# 🌐 Networking
############################################
EGRESS_IP_ENDPOINT=https://algogpt-docker.onrender.com/net/ip
BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

############################################
# 🧩 Versions / Metadata
############################################
ALGOGPT_VERSION=2.14.0
STRATEGY_VERSION=2.14.0
GIT_COMMIT=
REQ_HASH=

############################################
# 🚪 Server
############################################
PORT=10000















