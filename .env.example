# 🔐 Binance API
BINANCE_API_KEY=***your_binance_key***
BINANCE_API_SECRET=***your_binance_secret***

# 🤖 OpenAI API
OPENAI_API_KEY=***your_openai_key***

# 📰 News & Social APIs
CRYPTO_PANIC_API_KEY=***your_crypto_panic_key***
LUNARCRUSH_API_KEY=***your_lunarcrush_key***

# 📬 Email Alerts
ALERT_EMAIL_ADDRESS=***you@example.com***
ALERT_EMAIL_PASSWORD=***your_password***
ALERT_TO_EMAIL=***you@example.com***

# 🤖 Telegram Alerts
TELEGRAM_BOT_TOKEN=***your_telegram_token***
TELEGRAM_CHAT_ID=***your_chat_id***

# ⚙️ Auto Executor Settings
AUTO_RUN=true
MIN_QUALITY_SCORE=7
MAX_TRADE_BUDGET=250
SCAN_INTERVAL=10

# 📊 Volume & Trend Filters
MIN_VOLUME=1500000
TRENDING_ONLY=true

# 🌐 Scan Defaults
TRENDING_SOURCE=coingecko
DEFAULT_MARKET=futures
DEFAULT_INTERVAL=15m
TOP_SYMBOLS=1

# 📡 Server URL (Render)
SERVER_URL=https://algogpt-docker.onrender.com









