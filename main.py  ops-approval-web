from fastapi import FastAPI
from routes.ops_approve import router as ops_router
from routes.telegram_ping import router as tg_router

app = FastAPI(title="Ops Approval Webhook", version="0.1.0")

@app.get("/health")
async def health():
    return {"ok": True}

@app.get("/__whoami", include_in_schema=False)
async def whoami():
    return {"ok": True, "service": "ops-approval-web", "version": "0.1.0"}

# כולל רק את הראוטרים שלנו – בלי middlewares/אימות מהאפליקציה הגדולה
app.include_router(ops_router)
app.include_router(tg_router)




