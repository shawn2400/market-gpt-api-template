# workers/trade_watchdog.py
from __future__ import annotations
import os, time, asyncio, logging
from typing import Dict, Any, List, Optional

import httpx

from utils.trade_store import list_active, update_trade
from utils.redis_client import redis_client as RED  # may be None

BINANCE_FUTURES_HTTP_BASE = os.getenv("BINANCE_FUTURES_HTTP_BASE", "https://fapi.binance.com")

TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN","")
ADMIN_CHAT_ID      = os.getenv("ADMIN_CHAT_ID","")  # chat id למשל שלך
POLL_INTERVAL_SEC  = int(float(os.getenv("WATCHDOG_INTERVAL_SECONDS","20")))

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("trade_watchdog")

async def _get_price(sym: str) -> Optional[float]:
    url = f"{BINANCE_FUTURES_HTTP_BASE}/fapi/v1/ticker/price"
    try:
        async with httpx.AsyncClient(timeout=6) as client:
            r = await client.get(url, params={"symbol": sym})
            if r.status_code == 200:
                return float(r.json().get("price"))
    except Exception as e:
        log.warning({"event":"price_fail","sym":sym,"err":str(e)})
    return None

async def _tg_send(text: str, kb: Optional[dict] = None):
    if not TELEGRAM_BOT_TOKEN or not ADMIN_CHAT_ID:
        log.info({"event":"tg_skip","reason":"missing token/chat"})
        return
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": ADMIN_CHAT_ID, "text": text, "parse_mode": "HTML"}
    if kb: payload["reply_markup"] = kb
    try:
        async with httpx.AsyncClient(timeout=8) as client:
            await client.post(url, json=payload)
    except Exception as e:
        log.warning({"event":"tg_send_fail","err":str(e)})

def _flag_key(tid: str, name: str) -> str:
    return f"algogpt:wd:{tid}:{name}"

def _flag_is_set(tid: str, name: str) -> bool:
    if not RED: return False
    try:
        return bool(RED.get(_flag_key(tid,name)))
    except Exception:
        return False

def _flag_set(tid: str, name: str, ttl: int = 86400):
    if not RED: return
    try:
        RED.set(_flag_key(tid,name), "1", ex=ttl)
    except Exception:
        pass

def _touch_state(tr: Dict[str, Any], state: str):
    update_trade(tr["id"], {"status": state, f"state_{state}_ts": int(time.time())})

def _cross_up(p: float, level: float) -> bool:
    return p is not None and level is not None and p >= level

def _cross_down(p: float, level: float) -> bool:
    return p is not None and level is not None and p <= level

async def loop():
    while True:
        try:
            act = list_active()
            for tr in act:
                sym  = tr.get("symbol") or tr.get("proposal",{}).get("symbol")
                if not sym: continue
                side = tr.get("proposal",{}).get("side","LONG").upper()
                entry= float(tr.get("proposal",{}).get("entry") or 0)
                sl   = float(tr.get("proposal",{}).get("sl") or 0)
                tp1  = float(tr.get("proposal",{}).get("tp1") or 0)
                tid  = tr.get("id")

                price = await _get_price(sym)
                if price is None or price<=0: continue

                status = tr.get("status","TRACKED").upper()

                # פתיחה כשל המחיר מגיע ל-entry
                if status in {"TRACKED","PENDING"}:
                    if (side=="LONG" and _cross_up(price, entry)) or (side=="SHORT" and _cross_down(price, entry)):
                        _touch_state(tr, "OPEN")
                        await _tg_send(f"🚀 <b>{sym}</b> נפתח במחיר ~<b>{price:.4f}</b> (יעד1: {tp1}, SL: {sl})")
                        continue

                # TP1
                if status=="OPEN" and not _flag_is_set(tid,"tp1"):
                    hit = (_cross_up(price, tp1) if side=="LONG" else _cross_down(price, tp1))
                    if hit:
                        _flag_set(tid,"tp1")
                        kb = {"inline_keyboard":[[
                            {"text":"🔒 עדכן SL → BE","callback_data": f"slbe:{tid}"}
                        ]]}
                        await _tg_send(f"✅ <b>{sym}</b> הגיע ל־TP1 ({tp1}).", kb)
                        continue

                # SL
                if status=="OPEN" and not _flag_is_set(tid,"sl"):
                    hit_sl = (_cross_down(price, sl) if side=="LONG" else _cross_up(price, sl))
                    if hit_sl:
                        _flag_set(tid,"sl")
                        _touch_state(tr, "CLOSED")
                        await _tg_send(f"⛔ <b>{sym}</b> פגע ב־SL ({sl}). נסגר.")
                        continue

        except Exception as e:
            log.error({"event":"watchdog_err","err":str(e)})
        await asyncio.sleep(POLL_INTERVAL_SEC)

if __name__ == "__main__":
    asyncio.run(loop())



