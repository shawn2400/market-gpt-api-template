# workers/trade_watchdog.py
from __future__ import annotations
import os, time, json, math, asyncio, logging
from typing import List, Dict, Any, Optional
from datetime import datetime, timezone

import httpx
from utils.anchor import evaluate_anchor

BINANCE_FUTURES_HTTP_BASE = os.getenv("BINANCE_FUTURES_HTTP_BASE", "https://fapi.binance.com")
CHECK_INTERVAL_SECONDS    = int(float(os.getenv("WATCHDOG_INTERVAL_SECONDS","180")))   # כל 3 דק׳
NEAR_PCT                  = float(os.getenv("WATCHDOG_NEAR_PCT","0.35"))               # קרבה ליעד/סטופ באחוז
BUNDLE_WINDOW_SECONDS     = int(float(os.getenv("WATCHDOG_BUNDLE_WINDOW","60")))

ACTIVE_TRADES_URL         = os.getenv("CORE_ACTIVE_TRADES_URL","").strip()
ACTIVE_TRADES_TOKEN       = os.getenv("CORE_ACTIVE_TRADES_TOKEN","").strip()
ACTIVE_TRADES_PATH        = os.getenv("ACTIVE_TRADES_PATH","data/active_trades.json")

OUTGOING_WEBHOOK_URL      = os.getenv("OUTGOING_WEBHOOK_URL","").strip()
OUTGOING_TOKEN            = os.getenv("OUTGOING_TOKEN","").strip()

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("trade_watchdog")

async def get_mark_price(sym: str) -> Optional[float]:
    url = f"{BINANCE_FUTURES_HTTP_BASE}/fapi/v1/premiumIndex"
    try:
        async with httpx.AsyncClient(timeout=8) as client:
            r = await client.get(url, params={"symbol": sym})
            if r.status_code == 200:
                j = r.json()
                p = j.get("markPrice")
                return float(p) if p else None
    except Exception:
        pass
    return None

async def load_active_trades() -> List[Dict[str, Any]]:
    # עדיפות ל־URL
    if ACTIVE_TRADES_URL:
        headers = {}
        if ACTIVE_TRADES_TOKEN:
            headers["Authorization"] = f"Bearer {ACTIVE_TRADES_TOKEN}"
        try:
            async with httpx.AsyncClient(timeout=8) as client:
                r = await client.get(ACTIVE_TRADES_URL, headers=headers)
                if r.status_code == 200:
                    j = r.json()
                    return j.get("trades") or j if isinstance(j, list) else []
        except Exception as e:
            log.warning({"event":"load_active_trades_http_fail","err":str(e)})
    # קובץ fallback
    try:
        with open(ACTIVE_TRADES_PATH,"r",encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, list) else []
    except Exception:
        return []

def pct(a: float, b: float) -> float:
    try:
        return 100.0 * abs(a-b) / b if b else 0.0
    except Exception:
        return 0.0

async def post_alert(payload: dict) -> bool:
    if not OUTGOING_WEBHOOK_URL:
        print("[WATCHDOG-DRY]", json.dumps(payload, ensure_ascii=False))
        return True
    headers = {"Content-Type":"application/json"}
    if OUTGOING_TOKEN:
        headers["Authorization"] = f"Bearer {OUTGOING_TOKEN}"
    try:
        async with httpx.AsyncClient(timeout=8) as client:
            r = await client.post(OUTGOING_WEBHOOK_URL, json=payload, headers=headers)
            return r.status_code in (200,201,202)
    except Exception:
        return False

async def process_once():
    trades = await load_active_trades()
    if not trades:
        return

    msgs: List[str] = []
    for t in trades:
        sym = t.get("symbol"); side = (t.get("side") or "").upper()
        entry = float(t.get("entry") or 0.0)
        sl    = float(t.get("sl") or 0.0)
        tp1   = float(t.get("tp1") or 0.0)
        tp2   = float(t.get("tp2") or 0.0)
        tp3   = float(t.get("tp3") or 0.0)
        if not sym or entry<=0 or sl<=0 or tp1<=0:
            continue

        price = await get_mark_price(sym)
        if not price:
            continue

        # קרבה ליעדים
        near_msgs = []
        if pct(price, tp1) <= NEAR_PCT: near_msgs.append("⚑ קרוב ל-TP1")
        if tp2>0 and pct(price, tp2) <= NEAR_PCT: near_msgs.append("⚑ קרוב ל-TP2")
        if tp3>0 and pct(price, tp3) <= NEAR_PCT: near_msgs.append("⚑ קרוב ל-TP3")
        if pct(price, sl)  <= NEAR_PCT: near_msgs.append("⚠︎ קרוב ל-SL")

        # הצעת SL→BE אחרי TP1 (אם מצוין reached_tp1)
        reached_tp1 = bool(t.get("reached_tp1"))
        if reached_tp1:
            be = entry
            near_msgs.append(f"🛡️ הצעה: עדכון SL→BE ({be:.6f})")

        # Anchor שינוי בייס
        dec = evaluate_anchor(side or "LONG", mode="soft")
        if not dec.allow:
            near_msgs.append(f"⚠︎ Anchor נגד הכיוון ({dec.bias}, score={dec.score:.0f})")

        if near_msgs:
            msgs.append(f"{sym} @ {price:.6f}: " + " | ".join(near_msgs))

    # Bundling: הודעה אחת מרוכזת
    if msgs:
        payload = {
            "type": "watchdog_summary",
            "ts": int(time.time()),
            "items": msgs
        }
        await post_alert(payload)

async def main():
    while True:
        try:
            await process_once()
        except Exception as e:
            log.error({"event":"watchdog_error","err":str(e)})
        await asyncio.sleep(CHECK_INTERVAL_SECONDS)

if __name__ == "__main__":
    asyncio.run(main())


