{
  "id": null,
  "title": "AlgoGPT – Core",
  "tags": ["algogpt", "fastapi", "trading"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Blackbox /health (probe_success)",
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "avg(probe_success{job=\"algogpt-health\"})"}],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "RPS (סה\"כ)",
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(rate(algogpt_api_requests_total[1m]))"}],
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "שיעור 5xx",
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum(rate(algogpt_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(algogpt_api_requests_total[5m])),1)"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 0.01},
            {"color": "red", "value": 0.05}
          ]}
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center"}
    },
    {
      "type": "stat",
      "title": "Telegram OK/Fail (5m)",
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(rate(algogpt_telegram_messages_sent_total[5m])) / clamp_min(sum(rate(algogpt_telegram_messages_sent_total[5m])) + sum(rate(algogpt_telegram_messages_failed_total[5m])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.7},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center"}
    }
  ]
}





