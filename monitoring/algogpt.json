{
  "title": "AlgoGPT – Alerts",
  "uid": "algogpt-alerts",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["algogpt", "alerts"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "table",
      "title": "Active Alerts",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "ALERTS{alertstate=\"firing\"}", "legendFormat": "{{alertname}} ({{severity}})" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      }
    }
  ],
  "refresh": "10s"
}



