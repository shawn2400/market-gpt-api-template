{
  "id": null,
  "title": "AlgoGPT – Overview",
  "tags": ["algogpt", "overview", "main"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "type": "text",
      "title": "AlgoGPT Dashboard Navigation",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": {
        "content": "## 🚀 AlgoGPT Main Overview\n\n- 📊 [Core Metrics](d/algogpt-core/algogpt-core)\n- 💹 [Trades Dashboard](d/algogpt-trades/algogpt-trades)\n- 🚨 [Alerts Summary](d/algogpt-alerts/alerts)\n- 🔔 [Live Alerts (Alertmanager)](d/alerts-live/alerts-live)\n\n⏱ Refresh: 30s | Version: *2.18.0*"
      },
      "mode": "markdown"
    },
    {
      "type": "stat",
      "title": "Open Trades",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "algogpt_trades_open_total" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "type": "stat",
      "title": "Total PnL (USDT)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "algogpt_pnl_total_usdt" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 100 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "type": "stat",
      "title": "API 5xx Rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "sum(rate(algogpt_api_requests_total{status=~\"5..\"}[5m]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "continuous-GrYlRd" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "type": "heatmap",
      "title": "API Requests Heatmap (by Hour of Day)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(algogpt_api_requests_total[5m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "continuous-BlPu" }
        }
      },
      "options": {
        "showLegend": true,
        "calculation": "lastNotNull",
        "color": { "mode": "continuous" }
      }
    }
  ]
}




