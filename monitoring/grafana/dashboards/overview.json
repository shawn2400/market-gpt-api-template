{
  "id": null,
  "title": "AlgoGPT – Overview",
  "tags": ["algogpt", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "CPU Usage %",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute","steps":[{"color":"green"},{"color":"orange","value":70},{"color":"red","value":85}]}}}
    },
    {
      "type": "stat",
      "title": "Memory Usage %",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds":{"mode":"absolute","steps":[{"color":"green"},{"color":"orange","value":70},{"color":"red","value":80}]}}}
    },
    {
      "type": "timeseries",
      "title": "API Latency p95/p99",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(algogpt_api_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(algogpt_api_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries",
      "title": "API RPS",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum(rate(algogpt_api_requests_total[1m]))", "legendFormat": "RPS"}]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [{"expr": "sum(rate(algogpt_api_requests_total{status=~\"5..\"}[5m]))"}],
      "fieldConfig": {"defaults":{"unit":"ops","color":{"mode":"continuous-GrYlRd"}}}
    }
  ]
}


