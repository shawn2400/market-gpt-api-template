{
  "id": null,
  "title": "AlgoGPT – AI API",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "AI Requests OK",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(algogpt_ai_requests_total{status=\"ok\"})"}]
    },
    {
      "type": "stat",
      "title": "AI Requests Failed",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(algogpt_ai_requests_total{status=\"fail\"})"}]
    },
    {
      "type": "timeseries",
      "title": "AI Latency (p95)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(algogpt_ai_latency_seconds_bucket[5m])) by (le))"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}

