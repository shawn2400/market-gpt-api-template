{
  "id": null,
  "title": "AlgoGPT – Alerts (Live)",
  "tags": ["algogpt", "alerts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "table",
      "title": "Active Alerts",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "alertmanager", "uid": "alertmanager"},
      "targets": [
        {
          "expr": "ALERTS",
          "legendFormat": "{{ alertname }} – {{ severity }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 2}
            ]
          }
        }
      },
      "options": {
        "showHeader": true,
        "footer": {"show": false}
      }
    }
  ]
}

