{
  "id": null,
  "title": "AlgoGPT – Live Alerts",
  "tags": ["algogpt", "alerts", "live"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "table",
      "title": "Active Alerts (Alertmanager)",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "datasource": {
        "type": "alertmanager",
        "uid": "alertmanager"
      },
      "targets": [
        {
          "expr": "alerts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "critical": { "color": "red", "text": "Critical" },
                "warning": { "color": "orange", "text": "Warning" },
                "info": { "color": "blue", "text": "Info" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Severity",
            "desc": true
          }
        ]
      },
      "columns": [
        { "text": "Alertname", "value": "labels.alertname" },
        { "text": "Service", "value": "labels.service" },
        { "text": "Severity", "value": "labels.severity" },
        { "text": "Summary", "value": "annotations.summary" },
        { "text": "Description", "value": "annotations.description" },
        { "text": "Starts At", "value": "startsAt" },
        { "text": "Ends At", "value": "endsAt" }
      ]
    }
  ]
}





