{
  "id": null,
  "title": "AlgoGPT – Core System",
  "tags": ["algogpt", "core"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "API Latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(algogpt_api_latency_seconds_bucket[5m])) by (le))"}
      ]
    },
    {
      "type": "stat",
      "title": "API Errors (5xx / 5m)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum(rate(algogpt_api_5xx_total[5m]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {"mode": "absolute","steps":[{"color":"green"},{"color":"red","value":0.1}]}
        }
      }
    },
    {
      "type": "gauge",
      "title": "CPU Usage (%)",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "avg(rate(container_cpu_usage_seconds_total{container=\"algogpt\"}[5m])) * 100"}
      ]
    },
    {
      "type": "gauge",
      "title": "Memory Usage (MB)",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "container_memory_usage_bytes{container=\"algogpt\"} / 1024 / 1024"}
      ]
    }
  ]
}





