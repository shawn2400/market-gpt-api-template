    {"type":"stat","title":"Failure Ratio (5m)","gridPos":{"h":4,"w":6,"x":0,"y":12},"targets":[{"expr":"sum(rate(algogpt_telegram_messages_failed_total[5m])) / clamp_min(sum(rate(algogpt_telegram_messages_sent_total[5m])),1)"}]}
