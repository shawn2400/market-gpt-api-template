{
  "id": null,
  "title": "AlgoGPT – Trades",
  "tags": ["algogpt", "trades"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Closed Trades",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "algogpt_trades_closed_total"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "TP Hits by Level",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "increase(algogpt_tp_hits_total[1h])", "legendFormat": "TP {{level}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}}
    },
    {
      "type": "timeseries",
      "title": "SL / BE / Trailing",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "increase(algogpt_sl_hits_total[1h])", "legendFormat": "SL"},
        {"expr": "increase(algogpt_breakeven_moves_total[1h])", "legendFormat": "BE"},
        {"expr": "increase(algogpt_trailing_moves_total[1h])", "legendFormat": "Trailing"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}}
    }
  ]
}

