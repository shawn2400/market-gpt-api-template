  "version": 1,
  "refresh": "5s",
  "panels": [
    {"type": "stat","title": "Open Trades","gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"algogpt_trades_open_total"}]},
    {"type": "stat","title": "Closed Trades","gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"algogpt_trades_closed_total"}]},
    {"type": "stat","title": "PnL (USDT)","gridPos":{"h":4,"w":6,"x":12,"y":0},"targets":[{"expr":"algogpt_pnl_total_usdt"}]},
    {"type": "timeseries","title":"TP Hits by Level","gridPos":{"h":8,"w":12,"x":0,"y":4},"targets":[{"expr":"sum by(level)(increase(algogpt_tp_hits_total[1h]))"}]},
    {"type": "timeseries","title":"SL Hits","gridPos":{"h":8,"w":12,"x":12,"y":4},"targets":[{"expr":"increase(algogpt_sl_hits_total[1h])"}]},
    {"type": "timeseries","title":"Breakeven vs Trailing","gridPos":{"h":8,"w":24,"x":0,"y":12},"targets":[
      {"expr":"increase(algogpt_breakeven_moves_total[1h])","legendFormat":"Breakeven"},
      {"expr":"increase(algogpt_trailing_moves_total[1h])","legendFormat":"Trailing"}
    ]}
  ]
