# --- Runtime ---
AUTO_RUN=true
SCAN_INTERVAL=60
DEFAULT_INTERVAL=15m
MIN_QUALITY_SCORE=6
MIN_VOLUME=1000000
TOP_SYMBOLS=30
TRENDING_ONLY=true

# ⚠️ על Render אין לקבע PORT (Railway מזרים PORT). השאר ריק אם הפלטפורמה מגדירה לבד.
# PORT=

# --- Trading budget/limits ---
MAX_TRADE_BUDGET=100
MAX_LEVERAGE=35

# --- Binance ---
BINANCE_API_KEY=__REPLACE_WITH_NEW_KEY__
BINANCE_API_SECRET=__REPLACE_WITH_NEW_SECRET__

# בסיסי API
BINANCE_SPOT_HTTP_BASE=https://api.binance.com
BINANCE_FUTURES_HTTP_BASE=https://fapi.binance.com
BINANCE_BACKOFF_BASE=0.7
BINANCE_MAX_RETRIES=5
BINANCE_RECV_WINDOW=10000
BINANCE_TIME_SYNC_INTERVAL_SEC=900

# מצבי חשבון
BINANCE_FORCE_HEDGE_MODE=false

# ⚠️ בזמן שה-IP לא מאושר – השאר true כדי לחסום פעולות כתיבה (מניעת שגיאות 403).
# אחרי שמוסיפים את ה-IP ב-Binance API Management – החלף ל-false.
BINANCE_SKIP_ACCOUNT_MUTATIONS=true

# --- Egress IP helper ---
# בזמן זיהוי ה-egress IP השאר 0.0.0.0 כדי שהאפליקציה תדווח בלוג מהו ה-IP בפועל
BINANCE_ALLOWED_EGRESS_IPS=0.0.0.0
# אם כבר ידוע ה-IP המאושר, שים אותו כהערך הזה (CSV):
# BINANCE_ALLOWED_EGRESS_IPS=18.156.158.53,18.156.42.200,52.59.103.54

# --- OpenAI ---
OPENAI_API_KEY=__REPLACE_WITH_NEW_OPENAI_KEY__
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_CONCURRENCY=4
# OPENAI_BASE_URL=

