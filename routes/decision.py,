# routes/decision.py
from __future__ import annotations
from typing import Dict, Any
from fastapi import APIRouter, Depends, Body

try:
    from utils.auth import require_bearer_token
except Exception:
    def require_bearer_token(): return None

from utils.decision_engine import pick_best_trades

router = APIRouter(prefix="/decision", tags=["Analytics"], dependencies=[Depends(require_bearer_token)])

@router.post("/best-trades", summary="Select best trades (quality/speed/diversify)", operation_id="postDecisionBestTrades")
async def best_trades(payload: Dict[str, Any] = Body(...)) -> Dict[str, Any]:
    cands = payload.get("candidates") or []
    top_n = int(payload.get("top_n", 5))
    diversify = bool(payload.get("diversify_by_symbol", True))
    return pick_best_trades(cands, top_n=top_n, diversify_by_symbol=diversify)

