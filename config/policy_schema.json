{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlgoGPT Dynamic Policy Schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "policy_name": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "signed": { "type": "boolean" },
        "updated_at": { "type": "string" }
      },
      "required": ["policy_name", "version"]
    },

    "routing": {
      "type": "object",
      "properties": {
        "public_routes": { "type": "array", "items": { "type": "string" } },
        "protected_routes": { "type": "array", "items": { "type": "string" } }
      }
    },

    "controls": {
      "type": "object",
      "properties": {
        "dynamic_control_enable": { "type": "boolean" },
        "safety_mode": { "type": "string" },
        "target_p95_ms": { "type": "integer", "minimum": 0 },
        "max_error_rate_pct": { "type": "number", "minimum": 0 },
        "cpu_high_watermark_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "cpu_low_watermark_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "mem_high_watermark_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "scale_interval_sec": { "type": "integer", "minimum": 0 },
        "min_stabilize_sec": { "type": "integer", "minimum": 0 }
      }
    },

    "load_shedding": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "p95_hard_ms": { "type": "integer", "minimum": 0 },
        "queue_max": { "type": "integer", "minimum": 0 },
        "reject_pct_step": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },

    "adaptive_limits": {
      "type": "object",
      "properties": {
        "rl": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "min_rps": { "type": "integer", "minimum": 0 },
            "max_rps": { "type": "integer", "minimum": 0 },
            "burst_min": { "type": "integer", "minimum": 0 },
            "burst_max": { "type": "integer", "minimum": 0 }
          }
        },
        "sse": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "max_conns_min": { "type": "integer", "minimum": 0 },
            "max_conns_max": { "type": "integer", "minimum": 0 },
            "per_ip_min": { "type": "integer", "minimum": 0 },
            "per_ip_max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "adaptive_workers": {
      "type": "object",
      "properties": {
        "scan": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "concurrency_min": { "type": "integer", "minimum": 0 },
            "concurrency_max": { "type": "integer", "minimum": 0 },
            "interval_sec_min": { "type": "integer", "minimum": 0 },
            "interval_sec_max": { "type": "integer", "minimum": 0 }
          }
        },
        "manager": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "interval_sec_min": { "type": "integer", "minimum": 0 },
            "interval_sec_max": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "health_guards": {
      "type": "object",
      "properties": {
        "redis": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "degrade_on_error": { "type": "boolean" }
          }
        },
        "exchange": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "halt_trading_on_degraded": { "type": "boolean" },
            "recovery_grace_sec": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "risk": {
      "type": "object",
      "properties": {
        "dynamic_risk_enable": { "type": "boolean" },
        "dynamic_max_trade_budget": {
          "type": "object",
          "properties": {
            "min_usdt": { "type": "number", "minimum": 0 },
            "max_usdt": { "type": "number", "minimum": 0 }
          },
          "required": ["min_usdt", "max_usdt"]
        },
        "dynamic_daily_loss_cap": {
          "type": "object",
          "properties": {
            "min_usdt": { "type": "number", "minimum": 0 },
            "max_usdt": { "type": "number", "minimum": 0 }
          },
          "required": ["min_usdt", "max_usdt"]
        },
        "cooldowns": {
          "type": "object",
          "properties": { "enable": { "type": "boolean" } }
        },
        "rails": { "type": "object" }
      }
    },

    "sessions": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "window": { "type": "string" },
              "action": { "type": "string" }
            },
            "required": ["window", "action"]
          }
        }
      }
    },

    "breakeven": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "only_after_tp1": { "type": "boolean" },
        "offset_bps": { "type": "number", "minimum": 0 },
        "guard_every_sec": { "type": "integer", "minimum": 0 },
        "arm_pct": { "type": "number", "minimum": 0 },
        "stair": {
          "type": "object",
          "properties": {
            "steps": { "type": "integer", "minimum": 0 },
            "factor": { "type": "number", "minimum": 0 }
          }
        },
        "bounds_bps": {
          "type": "object",
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          }
        }
      },
      "required": ["enable", "offset_bps"]
    },

    "trailing": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "atr_mult": { "type": "number", "minimum": 0 },
        "callback_min_pct": { "type": "number", "minimum": 0 },
        "callback_max_pct": { "type": "number", "minimum": 0 },
        "freeze_on_pullback": { "type": "boolean" },
        "enable_dynamic_trailing": { "type": "boolean" },
        "in_chop": { "type": "boolean" },
        "real_time": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "interval_sec": { "type": "integer", "minimum": 0 },
            "atr_mult": { "type": "number", "minimum": 0 },
            "price_src": { "type": "string" },
            "max_symbols": { "type": "integer", "minimum": 0 },
            "adjust_threshold_pct": { "type": "number", "minimum": 0 }
          }
        }
      },
      "required": ["enable", "atr_mult"]
    },

    "ladders": {
      "type": "object",
      "properties": {
        "tp": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "targets_pct": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 1
            },
            "splits": {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "minItems": 1
            },
            "merge_tick_band": { "type": "number", "minimum": 0 },
            "rearm_tick": { "type": "number", "minimum": 0 },
            "place_native": { "type": "boolean" }
          },
          "required": ["enable"]
        },
        "sl": {
          "type": "object",
          "properties": {
            "enable": { "type": "boolean" },
            "monotonic": { "type": "boolean" },
            "stop_band_bps": { "type": "number", "minimum": 0 },
            "struct": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "lookback": { "type": "integer", "minimum": 1 },
                "left": { "type": "integer", "minimum": 0 },
                "right": { "type": "integer", "minimum": 0 },
                "buffer_bps": { "type": "number", "minimum": 0 },
                "merge_mode": { "type": "string" }
              }
            },
            "atr_mult": { "type": "number", "minimum": 0 },
            "place_native": { "type": "boolean" }
          },
          "required": ["enable"]
        }
      },
      "required": ["tp", "sl"]
    },

    "entries": {
      "type": "object",
      "properties": {
        "allow_market": { "type": "boolean" },
        "entry_band_bps": { "type": "number", "minimum": 0 },
        "gap": {
          "type": "object",
          "properties": {
            "max_pct": { "type": "number", "minimum": 0 },
            "warn_pct": { "type": "number", "minimum": 0 }
          }
        },
        "trigger": { "type": "string" },
        "post_only": { "type": "boolean" }
      }
    },

    "checklist": { "type": "object" },
    "indicators": { "type": "object" },
    "thresholds": { "type": "object" },
    "guards": { "type": "object" },

    "btc_gate": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "tf": { "type": "string" },
        "long_req": { "type": "string" },
        "short_req": { "type": "string" }
      }
    },

    "manager": { "type": "object" },
    "approvals": { "type": "object" },
    "notifications": { "type": "object" },
    "digest": { "type": "object" },
    "eta": { "type": "object" },
    "watchlist": { "type": "object" },
    "binance": { "type": "object" },
    "sizing": { "type": "object" },
    "overrides": { "type": "object" },
    "kill_switch": { "type": "object" }
  },

  "required": ["breakeven", "trailing", "ladders"],
  "additionalProperties": true
}

